@using student_resource_hub.Models
@model ResourceListViewModel<Note>

@{
    ViewData["Title"] = "Study Notes";
}

<link rel="stylesheet" href="~/css/resource-list.css" />

<div class="catalog-layout document-catalog">
    <!-- Filter Panel -->
    <aside class="filter-panel">
        <div class="filter-title">
            <h2>Filters</h2>
            <a href="@Url.Action("Notes", "Resource")" class="clear-filters">Clear all</a>
        </div>

        <form method="get" class="filter-form">
            <!-- Department Filter -->
            <fieldset>
                <legend>Department</legend>
                @foreach (var dept in Model.Departments)
                {
                    <label>
                        <input type="checkbox" name="department" value="@dept"
                               @(Model.SelectedDepartment == dept ? "checked" : "") />
                        @dept.Replace("ComputerScience", "Computer Science")
                    </label>
                }
            </fieldset>

            <!-- Year Filter -->
            <fieldset>
                <legend>Year</legend>
                @foreach (var yr in Model.Years)
                {
                    <label>
                        <input type="checkbox" name="year" value="@yr"
                               @(Model.SelectedYear == yr ? "checked" : "") />
                        @yr
                    </label>
                }
            </fieldset>

            <!-- Semester Filter -->
            <fieldset>
                <legend>Semester</legend>
                @foreach (var sem in Model.Semesters)
                {
                    <label>
                        <input type="checkbox" name="semester" value="@sem"
                               @(Model.SelectedSemester == sem ? "checked" : "") />
                        @sem
                    </label>
                }
            </fieldset>

            <button type="submit" class="filter-button">Apply Filters</button>
        </form>
    </aside>

    <!-- Content Section -->
    <section class="catalog-content">
        <div class="catalog-heading">
            <div>
                <span class="eyebrow">RESOURCE LIBRARY</span>
                <h1>Study Notes</h1>
                <p>Find clear, comprehensive notes shared by fellow students.</p>
            </div>
            <div class="sort-upload">
                <select id="sortSelect" onchange="updateSort(this.value)">
                    @{
                        var sorts = new[] { ("toprated", "Top rated"), ("newest", "Newest first"), ("mostDownloaded", "Most downloaded") };
                        foreach (var (value, text) in sorts)
                        {
                            if (Model.SelectedSort == value)
                            {
                                <option value="@value" selected="selected">@text</option>
                            }
                            else
                            {
                                <option value="@value">@text</option>
                            }
                        }
                    }
                </select>
                @if (User.IsInRole("Student") || User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("UploadNote", "Resource")" class="upload-button">+ Upload Notes</a>
                }
            </div>
        </div>

        <!-- Message Display -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Resource List -->
        <div class="document-list notes-list">
            @if (Model.Resources.Count > 0)
            {
                @foreach (var note in Model.Resources)
                {
                    var deptIcon = note.Department.ToString().StartsWith("Computer") ? "blue" :
                                   note.Department.ToString().StartsWith("Engineering") ? "teal" :
                                   note.Department.ToString().StartsWith("Math") ? "gold" :
                                   note.Department.ToString().StartsWith("Physics") ? "violet" :
                                   note.Department.ToString().StartsWith("Chemistry") ? "red" : "green";

                    <article class="document-card">
                        <span class="document-icon @deptIcon">📝</span>
                        <div class="document-main">
                            <span class="subject-tag">@note.Department.ToString().Replace("ComputerScience", "Computer Science")</span>
                            <h2>@note.Title</h2>
                            <p>@note.CourseCode</p>
                            <div class="document-meta">
                                <span>Uploaded by: @note.UploadedByUser?.FullName</span>
                                <span>Pages: @note.PageCount</span>
                                <span>★ @note.AverageRating.ToString("0.0")/5</span>
                            </div>
                            @if (!string.IsNullOrEmpty(note.Description))
                            {
                                <p class="meta-description">@note.Description</p>
                            }
                            <small class="upload-meta">@note.Year @note.Semester | 👁 @note.ViewCount views | ⬇ @note.DownloadCount downloads</small>
                        </div>
                        <div class="document-actions">
                            <a href="@Url.Action("NoteDetails", "Resource", new { id = note.Id })" class="primary-button">👁 View</a>
                            <a href="@Url.Action("Download", "Resource", new { id = note.Id, type = "note" })" class="primary-button" title="Download">⬇ Download</a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="no-results">
                    <p>No notes found matching your filters.</p>
                </div>
            }
        </div>
    </section>
</div>

<script>
    function updateSort(sortValue) {
        const currentParams = new URLSearchParams(window.location.search);
        currentParams.set('sortBy', sortValue);
        window.location.search = currentParams.toString();
    }

    // Handle multiple checkbox selection
    document.querySelectorAll('.filter-form input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const form = this.closest('.filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            formData.forEach((value, key) => {
                if (value) params.append(key, value);
            });

            // Preserve sort parameter
            const currentParams = new URLSearchParams(window.location.search);
            if (currentParams.has('sortBy')) {
                params.set('sortBy', currentParams.get('sortBy'));
            }

            window.location.search = params.toString();
        });
    });
</script>
