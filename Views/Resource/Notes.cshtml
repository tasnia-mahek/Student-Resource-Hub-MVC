@using student_resource_hub.Models
@model ResourceListViewModel<Note>

@{
    ViewData["Title"] = "Study Notes";
}

<link rel="stylesheet" href="~/css/resource-list.css" />

<div class="catalog-layout document-catalog">
    @if (Model.SelectedAcademicSemesterId != null)
    {
    <!-- Filter Panel -->
    <aside class="filter-panel">
        <div class="filter-title">
            <h2>Filters</h2>
            <a href="@Url.Action("Notes", "Resource")" class="clear-filters">Clear all</a>
        </div>

        <form method="get" class="filter-form">
            <div class="mb-3">
                <label for="search">Search</label>
                <input type="search" id="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Title, subject, professor..." />
            </div>

            <fieldset>
                <legend>Department</legend>
                <select name="department" class="form-control">
                    <option value="All">All</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.SelectedDepartment == dept ? true : null)">@dept.Replace("ComputerScience", "Computer Science")</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Year</legend>
                <select name="year" class="form-control">
                    <option value="0">All</option>
                    @foreach (var yr in Model.Years)
                    {
                        <option value="@yr" selected="@(Model.SelectedYear == yr ? true : null)">@yr</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Semester</legend>
                <select name="semester" class="form-control">
                    <option value="All">All</option>
                    @foreach (var sem in Model.Semesters)
                    {
                        <option value="@sem" selected="@(Model.SelectedSemester == sem ? true : null)">@sem</option>
                    }
                </select>
            </fieldset>

            <button type="submit" class="filter-button">Apply Filters</button>
        </form>
    </aside>
    }

    <!-- Content Section -->
    @if (Model.SelectedAcademicSemesterId != null)
    {
    <section class="catalog-content">
        <div class="catalog-heading">
            <div>
                <span class="eyebrow">RESOURCE LIBRARY</span>
                <h1>Study Notes</h1>
                <p>Find clear, comprehensive notes shared by fellow students.</p>
            </div>
            <div class="sort-upload">
                <select id="sortSelect" onchange="updateSort(this.value)">
                    @{
                        var sorts = new[] { ("toprated", "Top rated"), ("newest", "Newest first"), ("mostDownloaded", "Most downloaded") };
                        foreach (var (value, text) in sorts)
                        {
                            if (Model.SelectedSort == value)
                            {
                                <option value="@value" selected="selected">@text</option>
                            }
                            else
                            {
                                <option value="@value">@text</option>
                            }
                        }
                    }
                </select>
                @if (User.IsInRole("Admin") || User.IsInRole("CR"))
                {
                    <a href="@Url.Action("UploadNote", "Resource")" class="upload-button">+ Upload Notes</a>
                }
            </div>
        </div>

        <!-- Message Display -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Resource List -->
        <div class="document-list notes-list">
            @if (Model.CourseGroups.Count > 0)
            {
                @foreach (var course in Model.CourseGroups)
                {
                    <section class="course-resource-group">
                        <div class="catalog-heading"><div><span class="eyebrow">COURSE</span><h2>@course.CourseCode</h2><p>@course.SubjectName</p></div><span class="subject-tag">@course.Resources.Count note(s)</span></div>
                        @foreach (var note in course.Resources)
                        {
                            var deptIcon = note.Department.ToString().StartsWith("Computer") ? "blue" : note.Department.ToString().StartsWith("Engineering") ? "teal" : note.Department.ToString().StartsWith("Math") ? "gold" : note.Department.ToString().StartsWith("Physics") ? "violet" : note.Department.ToString().StartsWith("Chemistry") ? "red" : "green";
                            <article class="document-card">
                                <span class="document-icon @deptIcon">📝</span>
                                <div class="document-main">
                                    <span class="subject-tag">@note.Department.ToString().Replace("ComputerScience", "Computer Science")</span>
                                    <h2>@note.Title</h2>
                                    <p>@note.SubjectName · @note.CourseCode</p>
                                    <div class="document-meta"><span>@note.Year @note.Semester</span><span>Pages: @note.PageCount</span><span>★ @note.AverageRating.ToString("0.0")/5</span><span>@note.FileType?.TrimStart('.').ToUpperInvariant()</span></div>
                                    @if (!string.IsNullOrEmpty(note.Description))
                                    { <p class="meta-description">@note.Description</p> }
                                    <small class="upload-meta">By: @note.UploadedByUser?.FullName · Prof: @note.ProfessorName · 👁 @note.ViewCount views · ⬇ @note.DownloadCount downloads</small>
                                </div>
                                <div class="document-actions"><a href="@Url.Action("NoteDetails", "Resource", new { id = note.Id })" class="primary-button">👁 View</a><a href="@Url.Action("Sessions", "Study", new { resourceType = "note", resourceId = note.Id })" class="primary-button">📁 Organize</a><a href="@Url.Action("Download", "Resource", new { id = note.Id, type = "note" })" class="primary-button" title="Download">⬇ Download</a></div>
                            </article>
                        }
                    </section>
                }
            }
            else
            {
                <div class="no-results">
                    <p>No notes found matching your filters.</p>
                </div>
            }
        </div>
    </section>
    }
    else
    {
        <section class="catalog-content">
            <div class="catalog-heading"><div><span class="eyebrow">RESOURCE LIBRARY</span><h1>@(Model.SelectedAcademicDepartmentId == null ? "Study Notes by Department" : "Choose a Semester")</h1><p>@(Model.SelectedAcademicDepartmentId == null ? "Choose a department to browse its study notes." : "Choose a semester to see every note for this department.")</p></div></div>
            <div class="document-list">
                @if (Model.SelectedAcademicDepartmentId == null)
                {
                    @foreach (var group in Model.DepartmentGroups)
                    {
                        <a class="document-card" href="@Url.Action("Notes", "Resource", new { academicDepartmentId = group.AcademicDepartmentId })" style="background-image:linear-gradient(90deg,rgba(7,12,20,.94),rgba(7,12,20,.45)),url('@group.ImageUrl');background-size:cover;background-position:center;"><span class="document-icon blue">📚</span><div class="document-main"><span class="subject-tag">@group.UniversityName</span><h2>@group.Name</h2><p>@group.Count study notes available</p></div><span class="primary-button">Browse →</span></a>
                    }
                }
                else
                {
                    @foreach (var group in Model.SemesterGroups)
                    {
                        <a class="document-card" href="@Url.Action("Notes", "Resource", new { academicDepartmentId = group.AcademicDepartmentId, academicSemesterId = group.AcademicSemesterId })"><span class="document-icon teal">🗓</span><div class="document-main"><span class="subject-tag">Semester</span><h2>@group.Name</h2><p>@group.Count study notes available</p></div><span class="primary-button">View notes →</span></a>
                    }
                }
                @if ((Model.SelectedAcademicDepartmentId == null && Model.DepartmentGroups.Count == 0) || (Model.SelectedAcademicDepartmentId != null && Model.SemesterGroups.Count == 0))
                {<div class="no-results"><p>No approved study notes are available at this level yet.</p></div>}
            </div>
        </section>
    }
</div>

<script>
    function updateSort(sortValue) {
        const currentParams = new URLSearchParams(window.location.search);
        currentParams.set('sortBy', sortValue);
        window.location.search = currentParams.toString();
    }

    // Handle multiple checkbox selection
    document.querySelectorAll('.filter-form input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const form = this.closest('.filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            formData.forEach((value, key) => {
                if (value) params.append(key, value);
            });

            // Preserve sort parameter
            const currentParams = new URLSearchParams(window.location.search);
            if (currentParams.has('sortBy')) {
                params.set('sortBy', currentParams.get('sortBy'));
            }

            window.location.search = params.toString();
        });
    });
</script>
