@using student_resource_hub.Models
@model ResourceListViewModel<PastPaper>

@{
    ViewData["Title"] = "Past Papers";
}

<link rel="stylesheet" href="~/css/resource-list.css" />

<div class="catalog-layout document-catalog">
    @if (Model.SelectedAcademicSemesterId != null && Model.SelectedCourseCode != null)
    {
    <!-- Filter Panel -->
    <aside class="filter-panel">
        <div class="filter-title">
            <h2>Filters</h2>
            <a href="@Url.Action("PastPapers", "Resource")" class="clear-filters">Clear all</a>
        </div>

        <form method="get" class="filter-form">
            <div class="mb-3">
                <label for="search">Search</label>
                <input type="search" id="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Title, subject, professor..." />
            </div>

            <fieldset>
                <legend>Department</legend>
                <select name="department" class="form-control">
                    <option value="All">All</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.SelectedDepartment == dept ? true : null)">@dept.Replace("ComputerScience", "Computer Science")</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Year</legend>
                <select name="year" class="form-control">
                    <option value="0">All</option>
                    @foreach (var yr in Model.Years)
                    {
                        <option value="@yr" selected="@(Model.SelectedYear == yr ? true : null)">@yr</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Semester</legend>
                <select name="semester" class="form-control">
                    <option value="All">All</option>
                    @foreach (var sem in Model.Semesters)
                    {
                        <option value="@sem" selected="@(Model.SelectedSemester == sem ? true : null)">@sem</option>
                    }
                </select>
            </fieldset>

            <button type="submit" class="filter-button">Apply Filters</button>
        </form>
    </aside>
    }

    <!-- Content Section -->
    @if (Model.SelectedAcademicSemesterId != null && Model.SelectedCourseCode != null)
    {
    <section class="catalog-content">
        <div class="catalog-heading">
            <div>
                <span class="eyebrow">RESOURCE LIBRARY</span>
                <h1>Past Papers</h1>
                <p>Practice with exams shared by students across departments.</p>
            </div>
            <div class="sort-upload">
                <form method="get" class="filter-form" style="display:inline-flex;align-items:center;gap:8px;">
                    <input type="hidden" name="academicDepartmentId" value="@Model.SelectedAcademicDepartmentId" /><input type="hidden" name="academicSemesterId" value="@Model.SelectedAcademicSemesterId" /><input type="hidden" name="courseCode" value="@Model.SelectedCourseCode" />
                    <label for="academicTermId">Exam term</label><select id="academicTermId" name="academicTermId" onchange="this.form.submit()">@foreach (var term in Model.ResourceTerms) { <option value="@(term.Id ?? 0)" selected="@(term.Id == Model.SelectedAcademicTermId ? "selected" : null)">@term.Name</option> }</select>
                </form>
                <select id="sortSelect" onchange="updateSort(this.value)">
                    @{
                        var sorts = new[] { ("newest", "Newest first"), ("oldest", "Oldest first"), ("mostDownloaded", "Most downloaded") };
                        foreach (var (value, text) in sorts)
                        {
                            if (Model.SelectedSort == value)
                            {
                                <option value="@value" selected="selected">@text</option>
                            }
                            else
                            {
                                <option value="@value">@text</option>
                            }
                        }
                    }
                </select>
                @if (User.IsInRole("Admin") || User.IsInRole("CR"))
                {
                    <a href="@Url.Action("UploadPastPaper", "Resource", new { academicCatalogSemesterId = Model.SelectedAcademicSemesterId, courseCode = Model.SelectedCourseCode })" class="upload-button">+ Upload Past Paper</a>
                }
            </div>
        </div>

        <!-- Message Display -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Resource List -->
        <div class="document-list">
            @if (Model.CourseGroups.Count > 0)
            {
                @foreach (var course in Model.CourseGroups)
                {
                    <section class="course-resource-group">
                        <div class="catalog-heading"><div><span class="eyebrow">COURSE</span><h2>@course.CourseCode</h2><p>@course.SubjectName</p></div><span class="subject-tag">@course.Resources.Count paper(s)</span></div>
                        @foreach (var paper in course.Resources)
                        {
                            var deptIcon = paper.Department.ToString().StartsWith("Computer") ? "blue" : paper.Department.ToString().StartsWith("Engineering") ? "teal" : paper.Department.ToString().StartsWith("Math") ? "gold" : paper.Department.ToString().StartsWith("Physics") ? "violet" : paper.Department.ToString().StartsWith("Chemistry") ? "red" : "green";
                            <article class="document-card">
                                <span class="document-icon @deptIcon">📄</span>
                                <div class="document-main">
                                    <span class="subject-tag">@paper.Department.ToString().Replace("ComputerScience", "Computer Science")</span>
                                    <h2>@paper.Title</h2>
                                    <p>@paper.SubjectName · @paper.CourseCode</p>
                                    <div class="document-meta"><span>@paper.Year @paper.Semester</span><span>👁 @paper.ViewCount</span><span>⬇ @paper.DownloadCount</span><span>@paper.FileType?.TrimStart('.').ToUpperInvariant()</span></div>
                                    @if (!string.IsNullOrEmpty(paper.Description))
                                    { <p class="meta-description">@paper.Description</p> }
                                    <small class="upload-meta">By: @paper.UploadedByUser?.FullName · Prof: @paper.ProfessorName</small>
                                </div>
                                <div class="document-actions"><a href="@Url.Action("PastPaperDetails", "Resource", new { id = paper.Id })" class="primary-button">👁 View</a><a href="@Url.Action("Sessions", "Study", new { resourceType = "paper", resourceId = paper.Id, courseCode = paper.CourseCode })" class="primary-button">📁 Organize</a><a href="@Url.Action("Download", "Resource", new { id = paper.Id, type = "paper" })" class="primary-button" title="Download">⬇ Download</a></div>
                            </article>
                        }
                    </section>
                }
            }
            else
            {
                <div class="no-results">
                    <p>No past papers found matching your filters.</p>
                </div>
            }
        </div>
    </section>
    }
    else
    {
        <section class="catalog-content">
            <div class="catalog-heading">
                <div>
                    <span class="eyebrow">RESOURCE LIBRARY</span>
                    <h1>@(Model.SelectedAcademicSemesterId != null ? "Choose a Course" : Model.SelectedAcademicDepartmentId == null ? "Past Papers by Department" : "Choose a Semester")</h1>
                    <p>@(Model.SelectedAcademicSemesterId != null ? "Choose a course to view its past papers." : Model.SelectedAcademicDepartmentId == null ? "Choose a department to browse its past papers." : "Choose a semester to see its courses.")</p>
                </div>
            </div>
            <div class="document-list">
                @if (Model.SelectedAcademicSemesterId != null)
                {
                    <div class="catalog-heading"><div><span class="eyebrow">COURSES</span><h2>Courses in this semester</h2></div></div>
                    @foreach (var course in Model.CourseCatalogGroups)
                    {
                        <a class="document-card" href="@Url.Action("PastPapers", "Resource", new { academicDepartmentId = Model.SelectedAcademicDepartmentId, academicSemesterId = Model.SelectedAcademicSemesterId, courseCode = course.CourseCode })"><span class="document-icon teal">📚</span><div class="document-main"><span class="subject-tag">@(course.IsLab ? "Lab course" : "Theory course")</span><h2>@course.CourseCode</h2><p>@course.Name</p><small class="upload-meta">@(course.ResourceCount == 0 ? "Uploading soon..." : $"{course.ResourceCount} paper(s) available")</small></div><span class="primary-button">View papers →</span></a>
                    }
                }
                else if (Model.SelectedAcademicDepartmentId == null)
                {
                    @foreach (var group in Model.DepartmentGroups)
                    {
                        <a class="document-card" href="@Url.Action("PastPapers", "Resource", new { academicDepartmentId = group.AcademicDepartmentId })" style="background-image:linear-gradient(90deg,rgba(7,12,20,.94),rgba(7,12,20,.45)),url('@group.ImageUrl');background-size:cover;background-position:center;">
                            <span class="document-icon blue">📚</span>
                            <div class="document-main"><span class="subject-tag">@group.UniversityName</span><h2>@group.Name</h2><p>@group.Count past papers available</p></div>
                            <span class="primary-button">Browse →</span>
                        </a>
                    }
                }
                else
                {
                    @foreach (var group in Model.SemesterGroups)
                    {
                        <a class="document-card" href="@Url.Action("PastPapers", "Resource", new { academicDepartmentId = group.AcademicDepartmentId, academicSemesterId = group.AcademicSemesterId })">
                            <span class="document-icon teal">🗓</span>
                            <div class="document-main"><span class="subject-tag">Semester</span><h2>@group.Name</h2><p>@group.Count past papers available</p></div>
                            <span class="primary-button">View papers →</span>
                        </a>
                    }
                }
                @if ((Model.SelectedAcademicDepartmentId == null && Model.DepartmentGroups.Count == 0) || (Model.SelectedAcademicDepartmentId != null && Model.SemesterGroups.Count == 0))
                {
                    <div class="no-results"><p>No approved past papers are available at this level yet.</p></div>
                }
            </div>
        </section>
    }
</div>

<script>
    function updateSort(sortValue) {
        const currentParams = new URLSearchParams(window.location.search);
        currentParams.set('sortBy', sortValue);
        window.location.search = currentParams.toString();
    }

    // Handle multiple checkbox selection
    document.querySelectorAll('.filter-form input[type="checkbox"]').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            const form = this.closest('.filter-form');
            const formData = new FormData(form);
            const params = new URLSearchParams();

            formData.forEach((value, key) => {
                if (value) params.append(key, value);
            });

            // Preserve sort parameter
            const currentParams = new URLSearchParams(window.location.search);
            if (currentParams.has('sortBy')) {
                params.set('sortBy', currentParams.get('sortBy'));
            }

            window.location.search = params.toString();
        });
    });
</script>
