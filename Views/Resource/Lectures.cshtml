@using student_resource_hub.Models
@model ResourceListViewModel<Lecture>

@{
    ViewData["Title"] = "Lectures";
}

<link rel="stylesheet" href="~/css/resource-list.css" />

<div class="catalog-layout document-catalog">
    @if (Model.SelectedAcademicSemesterId != null && Model.SelectedCourseCode != null)
    {
    <!-- Filter Panel -->
    <aside class="filter-panel">
        <div class="filter-title">
            <h2>Filters</h2>
            <a href="@Url.Action("Lectures", "Resource")" class="clear-filters">Clear all</a>
        </div>

        <form method="get" class="filter-form">
            <div class="mb-3">
                <label for="search">Search</label>
                <input type="search" id="search" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Title, subject, professor..." />
            </div>

            <fieldset>
                <legend>Department</legend>
                <select name="department" class="form-control">
                    <option value="All">All</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept" selected="@(Model.SelectedDepartment == dept ? true : null)">@dept.Replace("ComputerScience", "Computer Science")</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Year</legend>
                <select name="year" class="form-control">
                    <option value="0">All</option>
                    @foreach (var yr in Model.Years)
                    {
                        <option value="@yr" selected="@(Model.SelectedYear == yr ? true : null)">@yr</option>
                    }
                </select>
            </fieldset>

            <fieldset>
                <legend>Semester</legend>
                <select name="semester" class="form-control">
                    <option value="All">All</option>
                    @foreach (var sem in Model.Semesters)
                    {
                        <option value="@sem" selected="@(Model.SelectedSemester == sem ? true : null)">@sem</option>
                    }
                </select>
            </fieldset>

            <button type="submit" class="filter-button">Apply Filters</button>
        </form>
    </aside>
    }

    <!-- Content Section -->
    @if (Model.SelectedAcademicSemesterId != null && Model.SelectedCourseCode != null)
    {
    <section class="catalog-content">
        <div class="catalog-heading">
            <div>
                <span class="eyebrow">RESOURCE LIBRARY</span>
                <h1>Lectures</h1>
                <p>Access recorded lectures and materials from your courses.</p>
            </div>
            <div class="sort-upload">
                <form method="get" class="filter-form" style="display:inline-flex;align-items:center;gap:8px;"><input type="hidden" name="academicDepartmentId" value="@Model.SelectedAcademicDepartmentId" /><input type="hidden" name="academicSemesterId" value="@Model.SelectedAcademicSemesterId" /><input type="hidden" name="courseCode" value="@Model.SelectedCourseCode" /><label for="academicTermId">Exam term</label><select id="academicTermId" name="academicTermId" onchange="this.form.submit()">@foreach (var term in Model.ResourceTerms) { <option value="@(term.Id ?? 0)" selected="@(term.Id == Model.SelectedAcademicTermId ? "selected" : null)">@term.Name</option> }</select></form>
                <select id="sortSelect" onchange="updateSort(this.value)">
                    @{
                        var sorts = new[] { ("newest", "Newest first"), ("oldest", "Oldest first"), ("mostDownloaded", "Most downloaded") };
                        foreach (var (value, text) in sorts)
                        {
                            if (Model.SelectedSort == value)
                            {
                                <option value="@value" selected="selected">@text</option>
                            }
                            else
                            {
                                <option value="@value">@text</option>
                            }
                        }
                    }
                </select>
                @if (User.IsInRole("Admin") || User.IsInRole("CR"))
                {
                    <a href="@Url.Action("UploadLecture", "Resource", new { academicCatalogSemesterId = Model.SelectedAcademicSemesterId, courseCode = Model.SelectedCourseCode })" class="upload-button">+ Upload Lecture</a>
                }
            </div>
        </div>

        <!-- Message Display -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Resource List -->
        <div class="document-list">
            @if (Model.CourseGroups.Count > 0)
            {
                @foreach (var course in Model.CourseGroups)
                {
                    <section class="course-resource-group">
                        <div class="catalog-heading"><div><span class="eyebrow">COURSE</span><h2>@course.CourseCode</h2><p>@course.SubjectName</p></div><span class="subject-tag">@course.Resources.Count lecture(s)</span></div>
                        @foreach (var lecture in course.Resources)
                        {
                            var deptIcon = lecture.Department.ToString().StartsWith("Computer") ? "blue" : lecture.Department.ToString().StartsWith("Engineering") ? "teal" : lecture.Department.ToString().StartsWith("Math") ? "gold" : lecture.Department.ToString().StartsWith("Physics") ? "violet" : lecture.Department.ToString().StartsWith("Chemistry") ? "red" : "green";
                            <article class="document-card">
                                <span class="document-icon @deptIcon">🎓</span>
                                <div class="document-main">
                                    <span class="subject-tag">@lecture.Department.ToString().Replace("ComputerScience", "Computer Science")</span>
                                    <h2>@lecture.Title</h2>
                                    <p>@lecture.SubjectName · @lecture.CourseCode</p>
                                    <div class="document-meta"><span>@lecture.Year @lecture.Semester</span><span>👁 @lecture.ViewCount</span><span>⬇ @lecture.DownloadCount</span><span>@lecture.FileType?.TrimStart('.').ToUpperInvariant()</span></div>
                                    @if (!string.IsNullOrEmpty(lecture.Description))
                                    { <p class="meta-description">@lecture.Description</p> }
                                    <small class="upload-meta">By: @lecture.UploadedByUser?.FullName · Prof: @lecture.ProfessorName</small>
                                </div>
                                <div class="document-actions"><a href="@Url.Action("LectureDetails", "Resource", new { id = lecture.Id })" class="primary-button">👁 View</a><a href="@Url.Action("Sessions", "Study", new { resourceType = "lecture", resourceId = lecture.Id, courseCode = lecture.CourseCode, studySessionId = ViewBag.StudySessionId, studyFolderId = ViewBag.StudyFolderId, returnUrl = Context.Request.Path + Context.Request.QueryString })" class="primary-button">📁 Add to Study</a><a href="@Url.Action("Download", "Resource", new { id = lecture.Id, type = "lecture" })" class="primary-button" title="Download">⬇ Download</a></div>
                            </article>
                        }
                    </section>
                }
            }
            else
            {
                <div class="no-results">
                    <p>No lectures found matching your filters.</p>
                </div>
            }
        </div>
    </section>
    }
    else
    {
        <section class="catalog-content">
            <div class="catalog-heading"><div><span class="eyebrow">RESOURCE LIBRARY</span><h1>@(Model.SelectedAcademicSemesterId != null ? "Choose a Course" : Model.SelectedAcademicDepartmentId == null ? "Video Lectures by Department" : "Choose a Semester")</h1><p>@(Model.SelectedAcademicSemesterId != null ? "Choose a course to view its lectures." : Model.SelectedAcademicDepartmentId == null ? "Choose a department to browse its video lectures." : "Choose a semester to see its courses.")</p></div></div>
            <div class="document-list">
                @if (Model.SelectedAcademicSemesterId != null)
                {
                    <div class="catalog-heading"><div><span class="eyebrow">COURSES</span><h2>Courses in this semester</h2></div></div>
                    @foreach (var course in Model.CourseCatalogGroups) { <a class="document-card" href="@Url.Action("Lectures", "Resource", new { academicDepartmentId = Model.SelectedAcademicDepartmentId, academicSemesterId = Model.SelectedAcademicSemesterId, courseCode = course.CourseCode, studySessionId = ViewBag.StudySessionId, studyFolderId = ViewBag.StudyFolderId })"><span class="document-icon teal">🎓</span><div class="document-main"><span class="subject-tag">@(course.IsLab ? "Lab course" : "Theory course")</span><h2>@course.CourseCode</h2><p>@course.Name</p><small class="upload-meta">@(course.ResourceCount == 0 ? "Uploading soon..." : $"{course.ResourceCount} lecture(s) available")</small></div><span class="primary-button">View lectures →</span></a> }
                }
                else if (Model.SelectedAcademicDepartmentId == null)
                {
                    @foreach (var group in Model.DepartmentGroups)
                    {
                        <a class="document-card" href="@Url.Action("Lectures", "Resource", new { academicDepartmentId = group.AcademicDepartmentId, studySessionId = ViewBag.StudySessionId, studyFolderId = ViewBag.StudyFolderId })" style="background-image:linear-gradient(90deg,rgba(7,12,20,.94),rgba(7,12,20,.45)),url('@group.ImageUrl');background-size:cover;background-position:center;"><span class="document-icon blue">🎓</span><div class="document-main"><span class="subject-tag">@group.UniversityName</span><h2>@group.Name</h2><p>@group.Count video lectures available</p></div><span class="primary-button">Browse →</span></a>
                    }
                }
                else
                {
                    @foreach (var group in Model.SemesterGroups)
                    {
                        <a class="document-card" href="@Url.Action("Lectures", "Resource", new { academicDepartmentId = group.AcademicDepartmentId, academicSemesterId = group.AcademicSemesterId, studySessionId = ViewBag.StudySessionId, studyFolderId = ViewBag.StudyFolderId })"><span class="document-icon teal">🗓</span><div class="document-main"><span class="subject-tag">Semester</span><h2>@group.Name</h2><p>@group.Count video lectures available</p></div><span class="primary-button">View lectures →</span></a>
                    }
                }
                @if ((Model.SelectedAcademicDepartmentId == null && Model.DepartmentGroups.Count == 0) || (Model.SelectedAcademicDepartmentId != null && Model.SemesterGroups.Count == 0))
                {<div class="no-results"><p>No approved video lectures are available at this level yet.</p></div>}
            </div>
        </section>
    }
</div>

<script>
    function updateSort(sortValue) {
        // Get current filter values
        const params = new URLSearchParams(window.location.search);
        params.set('sortBy', sortValue);
        
        // Redirect with new sort parameter
        window.location.href = window.location.pathname + '?' + params.toString();
    }
</script>
