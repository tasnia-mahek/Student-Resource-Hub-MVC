@using student_resource_hub.Models
@model UploadNoteViewModel

@{
    ViewData["Title"] = "Upload Note";
}

<link rel="stylesheet" href="~/css/upload-form.css" />

<div class="upload-container">
    <div class="upload-header">
        <h1>Upload Study Notes</h1>
        <p>Share clear, helpful notes with other students in your course.</p>
    </div>

    <div class="upload-content">
        <form asp-action="UploadNote" asp-controller="Resource" method="post" enctype="multipart/form-data" class="upload-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-section">
                <h3>Note Details</h3>

                <div class="form-group">
                    <label asp-for="Title">Note Title *</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g., Week 5 Summary Notes" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SubjectName">Subject Name *</label>
                    <input asp-for="SubjectName" class="form-control" placeholder="e.g., Data Structures and Algorithms" />
                    <span asp-validation-for="SubjectName" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="CourseCode">Course Code *</label>
                        <input asp-for="CourseCode" class="form-control" placeholder="e.g., CS-201" />
                        <span asp-validation-for="CourseCode" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProfessorName">Professor/Lecturer Name</label>
                        <input asp-for="ProfessorName" class="form-control" placeholder="e.g., Dr. Sarah Johnson" />
                        <span asp-validation-for="ProfessorName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Description">Description (Optional)</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Add any extra context about these notes..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <h3>Course Details</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Department">Department *</label>
                        <select asp-for="Department" class="form-control">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in Enum.GetNames(typeof(Department)))
                            {
                                <option value="@dept">@dept.Replace("ComputerScience", "Computer Science")</option>
                            }
                        </select>
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Year">Year *</label>
                        <select asp-for="Year" class="form-control">
                            <option value="">-- Select Year --</option>
                            @foreach (var year in Enum.GetValues(typeof(Year)).Cast<Year>().OrderByDescending(y => y))
                            {
                                <option value="@year">@((int)year)</option>
                            }
                        </select>
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Semester">Semester *</label>
                        <select asp-for="Semester" class="form-control">
                            <option value="">-- Select Semester --</option>
                            @foreach (var sem in Enum.GetNames(typeof(Semester)))
                            {
                                <option value="@sem">@sem</option>
                            }
                        </select>
                        <span asp-validation-for="Semester" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3>File Upload</h3>

                <div class="file-upload-area" id="fileUploadArea">
                    <input type="file" id="File" name="File" asp-for="File" accept=".pdf,.doc,.docx,.ppt,.pptx,.jpg,.jpeg,.png,.gif" class="file-input" />
                    <div class="file-upload-text">
                        <span class="upload-icon">📁</span>
                        <p>Drag and drop your file here or click to browse</p>
                        <small>Supported formats: PDF, DOC, DOCX, PPT, PPTX, JPG, PNG, GIF (Max 50MB)</small>
                    </div>
                </div>

                <div id="fileSelected" class="file-selected" style="display: none;">
                    <p><strong>Selected file:</strong> <span id="fileName"></span></p>
                    <p><strong>File size:</strong> <span id="fileSize"></span></p>
                    <button type="button" class="change-file-btn" onclick="document.getElementById('File').click()">Change file</button>
                </div>

                <span asp-validation-for="File" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-large">Upload Note</button>
                <a asp-action="Notes" asp-controller="Resource" class="btn btn-secondary">Cancel</a>
            </div>

            <div class="info-box">
                <h4>📚 Upload Guidelines</h4>
                <ul>
                    <li>Upload only relevant lecture notes and study material.</li>
                    <li>Use concise titles and clear course names.</li>
                    <li>Files should be readable and properly formatted.</li>
                    <li>All uploads are subject to admin review before publication.</li>
                </ul>
            </div>
        </form>
    </div>
</div>

<script>
    const fileInput = document.getElementById('File');
    const fileUploadArea = document.getElementById('fileUploadArea');
    const fileSelected = document.getElementById('fileSelected');
    const fileName = document.getElementById('fileName');
    const fileSize = document.getElementById('fileSize');

    fileUploadArea.addEventListener('click', () => fileInput.click());
    fileUploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        fileUploadArea.classList.add('dragover');
    });

    fileUploadArea.addEventListener('dragleave', () => {
        fileUploadArea.classList.remove('dragover');
    });

    fileUploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        fileUploadArea.classList.remove('dragover');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            updateFileDisplay(files[0]);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
            updateFileDisplay(e.target.files[0]);
        }
    });

    function updateFileDisplay(file) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        fileName.textContent = file.name;
        fileSize.textContent = sizeMB + ' MB';
        fileUploadArea.style.display = 'none';
        fileSelected.style.display = 'block';
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
