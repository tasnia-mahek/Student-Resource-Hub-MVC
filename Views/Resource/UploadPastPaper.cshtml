@using student_resource_hub.Models
@model UploadResourceViewModel

@{
    ViewData["Title"] = "Upload Past Paper";
}

<link rel="stylesheet" href="~/css/upload-form.css" />

<div class="upload-container">
    <div class="upload-header">
        <h1>Upload Past Paper</h1>
        <p>Share your past papers with other students for collaborative learning</p>
    </div>

    <div class="upload-content">
        <form id="uploadForm" method="post" enctype="multipart/form-data" class="upload-form">
            @Html.AntiForgeryToken()
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <h4>Please fix the following errors:</h4>
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <!-- Subject Information Section -->
            <div class="form-section">
                <h3>Subject Information</h3>

                <div class="form-group">
                    <label for="Title">Title *</label>
                    <input type="text" id="Title" name="Title" asp-for="Title"
                           placeholder="e.g., Final Examination 2026" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="SubjectName">Subject Name *</label>
                    <input type="text" id="SubjectName" name="SubjectName" 
                           asp-for="SubjectName" placeholder="e.g., Data Structures and Algorithms"
                           class="form-control" required />
                    <span asp-validation-for="SubjectName" class="text-danger"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="CourseCode">Course Code *</label>
                        <input type="text" id="CourseCode" name="CourseCode" 
                               asp-for="CourseCode" placeholder="e.g., CS-201"
                               class="form-control" required />
                        <span asp-validation-for="CourseCode" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="ProfessorName">Professor/Lecturer Name *</label>
                        <input type="text" id="ProfessorName" name="ProfessorName" 
                               asp-for="ProfessorName" placeholder="e.g., Dr. Sarah Johnson"
                               class="form-control" required />
                        <span asp-validation-for="ProfessorName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="Description">Description (Optional)</label>
                    <textarea id="Description" name="Description" 
                              asp-for="Description" placeholder="Add any additional details about this past paper..."
                              class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <!-- Course Details Section -->
            <div class="form-section">
                <h3>Course Details</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label for="Department">Department *</label>
                        <select id="Department" name="Department" asp-for="Department" class="form-control" required>
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in Enum.GetNames(typeof(Department)))
                            {
                                <option value="@dept">@dept.Replace("ComputerScience", "Computer Science")</option>
                            }
                        </select>
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="Year">Year *</label>
                        <select id="Year" name="Year" asp-for="Year" class="form-control" required>
                            <option value="">-- Select Year --</option>
                            @foreach (var year in Enum.GetValues(typeof(Year)).Cast<Year>().OrderByDescending(y => y))
                            {
                                <option value="@year">@((int)year)</option>
                            }
                        </select>
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label for="Semester">Semester *</label>
                        <select id="Semester" name="Semester" asp-for="Semester" class="form-control" required>
                            <option value="">-- Select Semester --</option>
                            @foreach (var sem in Enum.GetNames(typeof(Semester)))
                            {
                                <option value="@sem">@sem</option>
                            }
                        </select>
                        <span asp-validation-for="Semester" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- File Upload Section -->
            <div class="form-section">
                <h3>File Upload</h3>

                <div class="file-upload-area" id="fileUploadArea">
                    <input type="file" id="File" name="File" asp-for="File" 
                           accept=".pdf,.doc,.docx,.ppt,.pptx,.txt,.jpg,.jpeg,.png"
                           class="file-input" required />
                    <div class="file-upload-text">
                        <span class="upload-icon">ðŸ“</span>
                        <p>Drag and drop your file here or click to browse</p>
                        <small>Supported formats: PDF, DOC, DOCX, PPT, PPTX, TXT, JPG, JPEG, PNG (Max 50MB)</small>
                    </div>
                </div>

                <div id="fileSelected" class="file-selected" style="display: none;">
                    <p><strong>Selected file:</strong> <span id="fileName"></span></p>
                    <p><strong>File size:</strong> <span id="fileSize"></span></p>
                    <button type="button" class="change-file-btn" onclick="document.getElementById('File').click()">Change file</button>
                </div>

                <span asp-validation-for="File" class="text-danger"></span>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-large">Upload Past Paper</button>
                <a href="@Url.Action("PastPapers", "Resource")" class="btn btn-secondary">Cancel</a>
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <h4>ðŸ“‹ Upload Guidelines</h4>
                <ul>
                    <li>Make sure the file contains actual past paper questions</li>
                    <li>Include all relevant information (year, semester, professor)</li>
                    <li>Files must be clear and properly formatted</li>
                    <li>All uploads are subject to admin review before publishing</li>
                    <li>Do not upload copyrighted material without proper permission</li>
                </ul>
            </div>
        </form>
    </div>


<script>
    const fileInput = document.getElementById('File');
    const fileUploadArea = document.getElementById('fileUploadArea');
    const fileSelected = document.getElementById('fileSelected');
    const fileName = document.getElementById('fileName');
    const fileSize = document.getElementById('fileSize');

    fileUploadArea.addEventListener('click', () => fileInput.click());
    fileUploadArea.addEventListener('dragover', (e) => {
        e.preventDefault();
        fileUploadArea.classList.add('dragover');
    });

    fileUploadArea.addEventListener('dragleave', () => {
        fileUploadArea.classList.remove('dragover');
    });

    fileUploadArea.addEventListener('drop', (e) => {
        e.preventDefault();
        fileUploadArea.classList.remove('dragover');
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            updateFileDisplay(files[0]);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
            updateFileDisplay(e.target.files[0]);
        }
    });

    function updateFileDisplay(file) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        fileName.textContent = file.name;
        fileSize.textContent = sizeMB + ' MB';
        fileUploadArea.style.display = 'none';
        fileSelected.style.display = 'block';
    }
</script>
