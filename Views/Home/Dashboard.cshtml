@model student_resource_hub.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Personal Dashboard";
}

<div class="dashboard-hub-container">
    <!-- Ambient Neon Background Glow Blooms -->
    <div class="neon-glow-bloom bloom-top-center" aria-hidden="true"></div>

    <!-- Welcome Hero Bar -->
    <div class="dashboard-welcome-header">
        <div class="welcome-user-info">
            <div class="outpayz-pill-badge">
                <span>Personalized Academic Space</span>
            </div>
            <h1 class="welcome-heading">
                Welcome back, <span class="outpayz-gradient-text">@Model.UserName</span>!
            </h1>
            <p class="welcome-subtitle">
                @if (Model.UserRole == "Admin")
                {
                    <span>Admin Panel Active &bull; You can publish past papers, video lectures, and manage campus attendance sessions.</span>
                }
                else if (Model.UserRole == "CR")
                {
                    <span>Class Representative Workspace &bull; You can share verified study notes, upload past papers, and inspect class attendance.</span>
                }
                else
                {
                    <span>Student Workspace &bull; Explore verified exam archives, watch lecture videos, study notes, and check in to active class sessions.</span>
                }
            </p>
        </div>

        <div class="welcome-action-group">
            <div class="user-role-tag role-@(Model.UserRole.ToLower())">
                <span class="tag-dot"></span>
                <span>@Model.UserRole Account</span>
            </div>
            <a asp-controller="Study" asp-action="Sessions" class="outpayz-btn-primary">
                <span>📁 Study Library</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            @if (Model.CanUploadPastPapers)
            {
                <a asp-controller="Resource" asp-action="UploadPastPaper" class="outpayz-btn-ghost">
                    <span>+ Upload Resource</span>
                </a>
            }
        </div>
    </div>

    <!-- 4 OutPayz KPI Stats Cards (Minimal & Clean) -->
    <div class="dashboard-kpi-grid">
        <!-- KPI 1: Personal Study Library -->
        <div class="dash-kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">PERSONAL STUDY LIBRARY</span>
            </div>
            <div class="kpi-value-row">
                <span class="kpi-metric text-neon">⌂</span>
            </div>
            <p class="kpi-desc">Your organized papers, notes, and lectures</p>
            <div class="kpi-bottom-link">
                <a asp-controller="Study" asp-action="Sessions">Open Study Library &rarr;</a>
            </div>
        </div>

        <!-- KPI 2: Past Papers -->
        <div class="dash-kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">PAST PAPERS ARCHIVE</span>
            </div>
            <div class="kpi-value-row">
                <span class="kpi-metric">@Model.TotalPastPapers</span>
            </div>
            <p class="kpi-desc">Verified midterm &amp; final exam solutions</p>
            <div class="kpi-bottom-link">
                <a asp-controller="Resource" asp-action="PastPapers">Browse Past Papers &rarr;</a>
            </div>
        </div>

        <!-- KPI 3: Study Notes -->
        <div class="dash-kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">PEER STUDY NOTES</span>
            </div>
            <div class="kpi-value-row">
                <span class="kpi-metric">@Model.TotalNotes</span>
            </div>
            <p class="kpi-desc">Top-ranked revision sheets &amp; summaries</p>
            <div class="kpi-bottom-link">
                <a asp-controller="Resource" asp-action="Notes">Read Study Notes &rarr;</a>
            </div>
        </div>

        <!-- KPI 4: Video Lectures -->
        <div class="dash-kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">VIDEO LECTURES</span>
            </div>
            <div class="kpi-value-row">
                <span class="kpi-metric">@Model.TotalLectures</span>
            </div>
            <p class="kpi-desc">High-yield faculty playlists &amp; demos</p>
            <div class="kpi-bottom-link">
                <a asp-controller="Resource" asp-action="Lectures">Watch Lectures &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Minimal Academic Engagement & Study Trends Graph -->
    <div class="dashboard-analytics-section mb-4">
        <div class="dash-card-box analytics-graph-card">
            <div class="analytics-header">
                <div class="analytics-title-group">
                    <span class="analytics-eyebrow">ACADEMIC ENGAGEMENT</span>
                    <h3 class="analytics-heading">Weekly Study &amp; Attendance Activity</h3>
                    <p class="analytics-subtitle">Track resource access, notes revisions, and attendance check-ins across the semester.</p>
                </div>
                <div class="chart-controls-group">
                    <div class="chart-legend-minimal">
                        <span class="legend-item"><span class="legend-dot green"></span> Attendance &amp; Study</span>
                        <span class="legend-item"><span class="legend-dot teal"></span> Material Downloads</span>
                    </div>
                    <div class="chart-filter-pills">
                        <button type="button" class="filter-btn active" data-range="week">7 Days</button>
                        <button type="button" class="filter-btn" data-range="month">30 Days</button>
                        <button type="button" class="filter-btn" data-range="term">Semester</button>
                    </div>
                </div>
            </div>

            <div class="analytics-body">
                <!-- SVG Area/Line Chart -->
                <div class="minimal-chart-container">
                    <div class="chart-y-axis">
                        <span>100%</span>
                        <span>75%</span>
                        <span>50%</span>
                        <span>25%</span>
                        <span>0%</span>
                    </div>
                    <div class="chart-canvas-wrapper">
                        <!-- Grid Lines -->
                        <div class="chart-gridlines">
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                        </div>

                        <!-- Smooth SVG Area Chart -->
                        <svg class="analytics-svg" viewBox="0 0 700 200" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="neonGreenGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#00FF66" stop-opacity="0.30" />
                                    <stop offset="70%" stop-color="#00FF66" stop-opacity="0.05" />
                                    <stop offset="100%" stop-color="#00FF66" stop-opacity="0" />
                                </linearGradient>
                                <linearGradient id="neonTealGradient" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#2DD4BF" stop-opacity="0.18" />
                                    <stop offset="100%" stop-color="#2DD4BF" stop-opacity="0" />
                                </linearGradient>
                            </defs>

                            <!-- Area 2 (Teal) -->
                            <path class="chart-area-teal" d="M 0,140 Q 58,125 116,95 T 233,115 T 350,80 T 466,95 T 583,50 T 700,65 L 700,200 L 0,200 Z" fill="url(#neonTealGradient)"></path>
                            <path class="chart-line-teal" d="M 0,140 Q 58,125 116,95 T 233,115 T 350,80 T 466,95 T 583,50 T 700,65" fill="none" stroke="#2DD4BF" stroke-width="1.8" stroke-dasharray="4 4" opacity="0.65"></path>

                            <!-- Area 1 (Neon Green Primary) -->
                            <path class="chart-area-green" d="M 0,160 Q 58,130 116,65 T 233,95 T 350,35 T 466,50 T 583,18 T 700,30 L 700,200 L 0,200 Z" fill="url(#neonGreenGradient)"></path>
                            <path class="chart-line-green" d="M 0,160 Q 58,130 116,65 T 233,95 T 350,35 T 466,50 T 583,18 T 700,30" fill="none" stroke="#00FF66" stroke-width="2.5" stroke-linecap="round"></path>

                            <!-- Interactive Glowing Data Points -->
                            <g class="chart-points">
                                <circle cx="116" cy="65" r="5" class="point-glow" />
                                <circle cx="116" cy="65" r="3" class="point-core" />

                                <circle cx="233" cy="95" r="5" class="point-glow" />
                                <circle cx="233" cy="95" r="3" class="point-core" />

                                <circle cx="350" cy="35" r="5" class="point-glow" />
                                <circle cx="350" cy="35" r="3" class="point-core" />

                                <circle cx="466" cy="50" r="5" class="point-glow" />
                                <circle cx="466" cy="50" r="3" class="point-core" />

                                <circle cx="583" cy="18" r="6" class="point-glow" />
                                <circle cx="583" cy="18" r="3.5" class="point-core" />

                                <circle cx="700" cy="30" r="5" class="point-glow" />
                                <circle cx="700" cy="30" r="3" class="point-core" />
                            </g>
                        </svg>

                        <!-- X Axis Labels -->
                        <div class="chart-x-axis">
                            <span>Mon</span>
                            <span>Tue</span>
                            <span>Wed</span>
                            <span>Thu</span>
                            <span>Fri</span>
                            <span>Sat</span>
                            <span>Sun</span>
                        </div>
                    </div>
                </div>

                <!-- Minimal Bottom Stats Row -->
                <div class="analytics-metrics-strip">
                    <div class="metric-col">
                        <span class="m-label">Avg Attendance</span>
                        <span class="m-val text-neon">@(Model.AttendancePercentage)%</span>
                        <span class="m-sub">Standing: Good</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-col">
                        <span class="m-label">Weekly Study Volume</span>
                        <span class="m-val">18.4 hrs</span>
                        <span class="m-sub">+2.1 hrs vs last week</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-col">
                        <span class="m-label">Active Modules</span>
                        <span class="m-val">6 Courses</span>
                        <span class="m-sub">Updated this week</span>
                    </div>
                    <div class="metric-divider"></div>
                    <div class="metric-col">
                        <span class="m-label">Semester Progress</span>
                        <span class="m-val">94%</span>
                        <span class="m-sub">On Track</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Personal Study Library & Role Panel Grid -->
    <div class="dashboard-split-grid">
        <!-- Left: Study Library -->
        <div class="dash-card-box">
            <div class="dash-card-header">
                <div>
                    <div class="bento-badge">
                        <span class="spark-icon">📁</span>
                        <span>Personal Workspace</span>
                    </div>
                    <h3>Organize your study materials</h3>
                    <p>Save papers, notes, and lectures into folders, then open or download them whenever you study.</p>
                </div>
                <a asp-controller="Study" asp-action="Sessions" class="btn-link-neon">Open Library &rarr;</a>
            </div>

            <div class="empty-dash-box">
                <span class="empty-icon">📚</span>
                <h4>Build a library that fits your semester</h4>
                <p>Start with a library, create folders for courses or topics, and add materials directly from any resource page.</p>
                <a asp-controller="Study" asp-action="Sessions" class="outpayz-btn-primary btn-sm-action">Manage Study Library</a>
            </div>
        </div>

        <!-- Right: Role Permissions & Quick Hub Actions -->
        <div class="dash-card-box">
            <div class="dash-card-header">
                <div>
                    <div class="bento-badge">
                        <span class="spark-icon">🛡️</span>
                        <span>Permissions &amp; Shortcuts</span>
                    </div>
                    <h3>Your Academic Workspace</h3>
                    <p>Verified privileges for your <strong>@Model.UserRole</strong> role.</p>
                </div>
            </div>

            <div class="role-privilege-box">
                @if (Model.UserRole == "Admin")
                {
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Full Upload Rights</strong>
                            <p>You can upload Past Papers and Video Lectures directly.</p>
                        </div>
                    </div>
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Attendance Session Creator</strong>
                            <p>You can launch passcode-protected attendance sessions for any course.</p>
                        </div>
                    </div>
                    <div class="dash-btn-row mt-3">
                        <a asp-controller="Resource" asp-action="UploadPastPaper" class="outpayz-btn-primary flex-grow-1 text-center">+ Upload Past Paper</a>
                        <a asp-controller="Resource" asp-action="UploadLecture" class="outpayz-btn-ghost flex-grow-1 text-center">+ Upload Lecture</a>
                    </div>
                }
                else if (Model.UserRole == "CR")
                {
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Class Representative Materials</strong>
                            <p>You can upload peer Study Notes and Past Papers for your section.</p>
                        </div>
                    </div>
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Roster &amp; Attendance Access</strong>
                            <p>Submit your own attendance and inspect class attendance rosters.</p>
                        </div>
                    </div>
                    <div class="dash-btn-row mt-3">
                        <a asp-controller="Resource" asp-action="UploadNote" class="outpayz-btn-primary flex-grow-1 text-center">+ Upload Notes</a>
                        <a asp-controller="Resource" asp-action="UploadPastPaper" class="outpayz-btn-ghost flex-grow-1 text-center">+ Upload Past Paper</a>
                    </div>
                }
                else
                {
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Unlimited Resource Access</strong>
                            <p>Browse, search, and download all verified past papers, notes, and lectures.</p>
                        </div>
                    </div>
                    <div class="privilege-item active">
                        <span class="priv-icon">✓</span>
                        <div>
                            <strong>Verified Student Attendance</strong>
                            <p>Submit session passcodes to register your class attendance instantly.</p>
                        </div>
                    </div>
                    <div class="dash-btn-row mt-3">
                        <a asp-controller="Resource" asp-action="PastPapers" class="outpayz-btn-primary flex-grow-1 text-center">Browse Exams</a>
                        <a asp-controller="Resource" asp-action="Notes" class="outpayz-btn-ghost flex-grow-1 text-center">Read Notes</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Resources Section -->
    <div class="dashboard-resources-section mt-5">
        <div class="section-title-row">
            <div>
                <h2>Recently Uploaded Materials</h2>
                <p>Latest verified academic assets submitted by faculty and class representatives.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Resource" asp-action="PastPapers" class="outpayz-btn-ghost btn-sm">All Papers</a>
                <a asp-controller="Resource" asp-action="Notes" class="outpayz-btn-ghost btn-sm">All Notes</a>
            </div>
        </div>

        <div class="recent-resources-grid">
            @if (Model.RecentPastPapers.Any())
            {
                @foreach (var paper in Model.RecentPastPapers)
                {
                    <div class="resource-mini-card">
                        <div class="res-card-top">
                            <span class="badge badge-primary">Past Paper</span>
                            <span class="course-code-badge">@paper.CourseCode</span>
                        </div>
                        <h4 class="res-title">@paper.Title</h4>
                        <div class="res-meta">
                            <span>🏛️ @paper.Department</span>
                            <span>👤 @(paper.UploadedByUser?.FullName ?? "Faculty")</span>
                        </div>
                        <div class="res-bottom-action">
                            <a asp-controller="Resource" asp-action="PastPaperDetails" asp-route-id="@paper.Id" class="btn-res-link">View Exam &rarr;</a>
                            <span class="text-muted">@(paper.DownloadCount) downloads</span>
                        </div>
                    </div>
                }
            }

            @if (Model.RecentNotes.Any())
            {
                @foreach (var note in Model.RecentNotes)
                {
                    <div class="resource-mini-card">
                        <div class="res-card-top">
                            <span class="badge badge-teal">Study Note</span>
                            <span class="course-code-badge">@note.CourseCode</span>
                        </div>
                        <h4 class="res-title">@note.Title</h4>
                        <div class="res-meta">
                            <span>🏛️ @note.Department</span>
                            <span>👤 @(note.UploadedByUser?.FullName ?? "Class Rep")</span>
                        </div>
                        <div class="res-bottom-action">
                            <a asp-controller="Resource" asp-action="NoteDetails" asp-route-id="@note.Id" class="btn-res-link">Read Note &rarr;</a>
                            <span class="text-neon">@(note.AverageRating > 0 ? $"{note.AverageRating:F1} ★" : "5.0 ★")</span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
.dashboard-hub-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 30px 24px 60px;
    position: relative;
}

.dashboard-welcome-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

.welcome-heading {
    font-size: 34px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    margin: 12px 0 8px;
}

.welcome-subtitle {
    color: var(--text-secondary);
    font-size: 15px;
    max-width: 680px;
    line-height: 1.6;
    margin: 0;
}

.welcome-action-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
}

.user-role-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #0E1018;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
}
.user-role-tag .tag-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}
.role-admin .tag-dot { background: #F43F5E; box-shadow: 0 0 8px #F43F5E; }
.role-cr .tag-dot { background: #A855F7; box-shadow: 0 0 8px #A855F7; }
.role-student .tag-dot { background: #00FF66; box-shadow: 0 0 8px #00FF66; }

/* KPI Grid */
.dashboard-kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 36px;
}

.dash-kpi-card {
    background: #090A10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
}

.dash-kpi-card:hover {
    border-color: rgba(0, 255, 102, 0.3);
    transform: translateY(-2px);
    background: #0D0F17;
}

.kpi-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.dash-kpi-card .kpi-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    text-transform: uppercase;
}

.kpi-value-row {
    margin-bottom: 8px;
}

.kpi-metric {
    font-size: 32px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
}

.kpi-progress-bar {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    margin: 8px 0 14px;
    overflow: hidden;
}

.kpi-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #00FF66, #A3E635);
    border-radius: var(--radius-full);
    box-shadow: 0 0 10px rgba(0, 255, 102, 0.5);
}

.kpi-desc {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin: 0 0 14px;
    flex-grow: 1;
}

.kpi-bottom-link a {
    color: var(--brand-primary);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
}
.kpi-bottom-link a:hover { text-decoration: underline; }

/* Split Grid */
.dashboard-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}

.dash-card-box {
    background: #090A10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 28px;
}

.dash-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 22px;
}

.dash-card-header h3 {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
    margin: 6px 0 4px;
}

.dash-card-header p {
    color: var(--text-secondary);
    font-size: 13.5px;
    margin: 0;
}

.btn-link-neon {
    color: var(--brand-primary);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
}
.btn-link-neon:hover { text-decoration: underline; }

.quick-sessions-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.quick-session-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background: #0E1019;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
}

.quick-session-item:hover {
    border-color: rgba(0, 255, 102, 0.25);
}

.quick-session-item.is-attended {
    background: rgba(0, 255, 102, 0.03);
    border-color: rgba(0, 255, 102, 0.3);
}

.quick-session-item h4 {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
}

.btn-sm-action {
    padding: 8px 18px;
    font-size: 13px;
}

.empty-dash-box {
    text-align: center;
    padding: 36px 16px;
    color: var(--text-secondary);
}

.role-privilege-box {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.privilege-item {
    display: flex;
    gap: 14px;
    padding: 16px;
    background: #0E1019;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
}

.priv-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 255, 102, 0.15);
    color: #00FF66;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    flex-shrink: 0;
}

.privilege-item strong {
    font-size: 14px;
    color: #ffffff;
    display: block;
    margin-bottom: 2px;
}

.privilege-item p {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin: 0;
}

.dash-btn-row {
    display: flex;
    gap: 12px;
}

/* Resources Section */
.section-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 22px;
}

.section-title-row h2 {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 4px;
}

.section-title-row p {
    color: var(--text-secondary);
    font-size: 14px;
    margin: 0;
}

.recent-resources-grid {
