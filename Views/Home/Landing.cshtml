@{
    ViewData["Title"] = "StudyHub - Academic Resource Platform";
}

<div class="outpayz-landing-container">
    <!-- Radiant Ambient Neon Background Glow Blooms -->
    <div class="neon-glow-bloom bloom-top-center" aria-hidden="true"></div>
    <div class="neon-glow-bloom bloom-hero-right" aria-hidden="true"></div>

    <!-- =========================================================================
         SECTION 1: HERO & MAIN VALUE PROPOSITION
         ========================================================================= -->
    <section class="outpayz-hero-section">
        <div class="outpayz-hero-content">
            <!-- Glowing Eyebrow Pill Badge -->
            <div class="outpayz-pill-badge">
                <span class="spark-icon">✳</span>
                <span>Modern academic hub, powered by intelligence</span>
            </div>

            <!-- High-Impact Display Typography -->
            <h1 class="outpayz-hero-title">
                From syllabus to exam success<br>
                <span class="outpayz-gradient-text">full academic visibility</span>
            </h1>

            <p class="outpayz-hero-subtitle">
                Empower students, class representatives, and faculty to access verified past papers, curated lecture videos, top-tier study notes, and real-time attendance management — with zero friction and full visibility.
            </p>

            <!-- Dual Pill Action Buttons -->
            <div class="outpayz-hero-actions">
                <a class="outpayz-btn-primary" asp-controller="Account" asp-action="Register">
                    <span>Get Started Free</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a class="outpayz-btn-ghost" asp-controller="Account" asp-action="Login">
                    <span>Sign In to Hub</span>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
                </a>
            </div>
        </div>

        <!-- =========================================================================
             SECTION 2: INTERACTIVE SAAS DASHBOARD BROWSER MOCKUP
             ========================================================================= -->
        <div class="outpayz-mockup-wrapper">
            <div class="outpayz-browser-window">
                <!-- Mac / Safari Window Top Bar -->
                <div class="browser-window-header">
                    <div class="browser-dots">
                        <span class="dot dot-red"></span>
                        <span class="dot dot-yellow"></span>
                        <span class="dot dot-green"></span>
                    </div>
                    <div class="browser-address-bar">
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <span>studyhub.edu/dashboard</span>
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                    </div>
                    <div class="browser-actions-icons">
                        <span>⤢</span>
                    </div>
                </div>

                <!-- Inside Dashboard Preview Screen -->
                <div class="mockup-inner-dashboard">
                    <!-- Dashboard Greeting & Header -->
                    <div class="mockup-topbar">
                        <div>
                            <h3 class="mockup-greeting">Good Morning, Scholar!</h3>
                            <p class="mockup-subtext">Here's what's trending in your academic department today.</p>
                        </div>
                        <div class="mockup-top-right">
                            <span class="mockup-date-chip">Today 📅</span>
                            <span class="stat-pill-green">Verified Access</span>
                        </div>
                    </div>

                    <!-- 4 KPI Stats Grid -->
                    <div class="mockup-stats-grid">
                        <div class="mockup-stat-card">
                            <span class="mockup-stat-label">TOTAL RESOURCES</span>
                            <div class="mockup-stat-row">
                                <span class="mockup-stat-val">1,248+</span>
                                <span class="stat-pill-green">+12.28%</span>
                            </div>
                            <a class="mockup-stat-link" asp-controller="Account" asp-action="Login">Sign in to view &rarr;</a>
                        </div>

                        <div class="mockup-stat-card">
                            <span class="mockup-stat-label">STUDY NOTES</span>
                            <div class="mockup-stat-row">
                                <span class="mockup-stat-val">482</span>
                                <span class="stat-pill-green">+8.45%</span>
                            </div>
                            <a class="mockup-stat-link" asp-controller="Account" asp-action="Login">Sign in to view &rarr;</a>
                        </div>

                        <div class="mockup-stat-card">
                            <span class="mockup-stat-label">PAST PAPERS</span>
                            <div class="mockup-stat-row">
                                <span class="mockup-stat-val">530</span>
                                <span class="stat-pill-green">+29.07%</span>
                            </div>
                            <a class="mockup-stat-link" asp-controller="Account" asp-action="Login">Sign in to view &rarr;</a>
                        </div>

                        <div class="mockup-stat-card">
                            <span class="mockup-stat-label">AVG RATING</span>
                            <div class="mockup-stat-row">
                                <span class="mockup-stat-val">4.9 ★</span>
                                <span class="stat-pill-gold">Top 1%</span>
                            </div>
                            <a class="mockup-stat-link" asp-controller="Account" asp-action="Login">Sign in to view &rarr;</a>
                        </div>
                    </div>

                    <!-- Charts & Visualizers Row -->
                    <div class="mockup-charts-grid">
                        <div class="mockup-chart-card">
                            <div class="chart-card-header">
                                <div>
                                    <h4>Total Resource Activity</h4>
                                    <div class="chart-legend">
                                        <span class="legend-dot green"></span> <span>Downloads</span>
                                        <span class="legend-dot teal"></span> <span>Reads</span>
                                        <span class="legend-dot gray"></span> <span>Views</span>
                                    </div>
                                </div>
                                <div class="chart-filters">
                                    <button class="filter-pill" type="button">All</button>
                                    <button class="filter-pill active" type="button">1M</button>
                                    <button class="filter-pill" type="button">6M</button>
                                </div>
                            </div>

                            <div class="neon-bar-chart">
                                <div class="bar-col"><div class="bar-fill" style="height: 38%;"></div><span>Mon</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 64%;"></div><span>Tue</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 48%;"></div><span>Wed</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 85%;"></div><span>Thu</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 94%;"></div><span>Fri</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 72%;"></div><span>Sat</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 52%;"></div><span>Sun</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 80%;"></div><span>Mon</span></div>
                                <div class="bar-col"><div class="bar-fill" style="height: 98%;"></div><span>Tue</span></div>
                            </div>
                        </div>

                        <div class="mockup-chart-card mockup-radar-card">
                            <div class="chart-card-header">
                                <div>
                                    <h4>Resources by Dept</h4>
                                    <p class="chart-subhead">Distribution by faculty</p>
                                </div>
                                <span class="stat-pill-green">Active</span>
                            </div>

                            <div class="radar-visualizer">
                                <svg class="radar-polygon-svg" viewBox="0 0 200 200">
                                    <polygon points="100,20 180,60 160,160 40,160 20,60" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                                    <polygon points="100,45 155,75 140,145 60,145 45,75" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
                                    <polygon points="100,28 170,68 145,150 50,135 32,68" fill="rgba(0,255,102,0.18)" stroke="#00FF66" stroke-width="2.5" filter="drop-shadow(0 0 8px rgba(0,255,102,0.6))"/>
                                    <circle cx="100" cy="28" r="4" fill="#00FF66"/>
                                    <circle cx="170" cy="68" r="4" fill="#00FF66"/>
                                    <circle cx="145" cy="150" r="4" fill="#00FF66"/>
                                    <circle cx="50" cy="135" r="4" fill="#00FF66"/>
                                    <circle cx="32" cy="68" r="4" fill="#00FF66"/>
                                </svg>
                                <div class="radar-labels">
                                    <span class="label-dept top">CSE <b>3,482</b></span>
                                    <span class="label-dept right">EEE <b>2,885</b></span>
                                    <span class="label-dept bottom-right">BBA <b>2,590</b></span>
                                    <span class="label-dept bottom-left">Civil <b>900</b></span>
                                    <span class="label-dept left">Pharmacy <b>650</b></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         SECTION 3: TRUST & SOCIAL PROOF BADGES
         ========================================================================= -->
    <section class="outpayz-trust-section">
        <span class="trust-title">Trusted by scholars, top university faculties, and academic departments nationwide.</span>
        <div class="trust-badges-cloud">
            <div class="trust-badge-item">
                <span class="trust-icon">✦</span>
                <span>Computer Science &amp; Engineering</span>
            </div>
            <div class="trust-badge-item">
                <span class="trust-icon">✦</span>
                <span>Electrical &amp; Electronic Engineering</span>
            </div>
            <div class="trust-badge-item">
                <span class="trust-icon">✦</span>
                <span>Business Administration</span>
            </div>
            <div class="trust-badge-item">
                <span class="trust-icon">✦</span>
                <span>Civil &amp; Environmental</span>
            </div>
            <div class="trust-badge-item">
                <span class="trust-icon">✦</span>
                <span>Pharmacy &amp; Health Sciences</span>
            </div>
        </div>
    </section>

    <!-- =========================================================================
         SECTION 4: HIGH-PERFORMANCE BENTO GRID MATRIX
         ========================================================================= -->
    <section class="outpayz-features-section">
        <div class="section-heading-center">
            <div class="outpayz-pill-badge">
                <span class="spark-icon">✳</span>
                <span>Core Academic Stack</span>
            </div>
            <h2 class="section-title">
                High-performance platform<br>
                built for students &amp; CRs
            </h2>
            <p class="section-subtitle">
                Experience lightning-fast searches, verified past papers, and integrated attendance management designed to keep your semester seamless.
            </p>
        </div>

        <div class="outpayz-bento-grid">
            <div class="bento-card bento-card-hero">
                <div class="bento-badge">
                    <span class="spark-icon">✳</span>
                    <span>Role-Based Permissions</span>
                </div>
                <h3>Admins &amp; CRs collaborate with students</h3>
                <p>Faculty &amp; Admins publish past exams and video lectures, CRs upload peer-verified class notes, and students browse with zero clutter.</p>
                <div class="bento-action-wrap">
                    <a class="outpayz-btn-ghost bento-btn" asp-controller="Account" asp-action="Register">
                        <span>Create Account</span>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>

            <div class="bento-card bento-card-stat">
                <span class="stat-massive">&lt; 0.2s</span>
                <span class="stat-caption">Instant search &amp; indexing latency</span>
            </div>

            <div class="bento-card bento-card-stat">
                <span class="stat-massive stat-scalable">100% Live</span>
                <span class="stat-caption">Passcode-based live class attendance</span>
            </div>

            <div class="bento-card bento-card-depth">
                <div class="ghost-numbers-container">
                    <span class="ghost-number-layer layer-1">10M+</span>
                    <span class="ghost-number-layer layer-2">10M+</span>
                    <span class="ghost-number-layer layer-3">10M+</span>
                </div>
                <div class="depth-card-footer">
                    <h4>10 Million verified downloads nationwide</h4>
                    <p>Trusted by students who rely on uninterrupted study materials.</p>
                </div>
            </div>

            <div class="bento-card bento-card-ai-preview">
                <div class="ai-card-content">
                    <div class="bento-badge">
                        <span class="spark-icon">✳</span>
                        <span>Intelligence &amp; AI</span>
                    </div>
                    <h3>The future of resource sharing is verified by peers</h3>
                    <p>Easily upload, bookmark, and review past papers with automated metadata extraction and instant moderation approval.</p>
                    
                    <div class="ai-feature-checklist">
                        <div class="checklist-item">
                            <span class="check-dot">✓</span>
                            <span>Lightning-fast PDF downloads</span>
                        </div>
                        <div class="checklist-item">
                            <span class="check-dot">✓</span>
                            <span>Curated by Top University TAs</span>
                        </div>
                        <div class="checklist-item">
                            <span class="check-dot">✓</span>
                            <span>Instant Attendance Passcode Validation</span>
                        </div>
                    </div>
                </div>

                <div class="ai-interactive-widget">
                    <div class="floating-chip chip-top">
                        <span class="chip-avatar">📚</span>
                        <div>
                            <strong>+ Midterm CSE-320 Solved</strong>
                            <small>Verified by Admin · Just now</small>
                        </div>
                        <span class="chip-icon-arrow">↑</span>
                    </div>

                    <div class="widget-center-orb">
                        <svg viewBox="0 0 24 24" width="48" height="48" fill="none">
                            <circle cx="12" cy="12" r="4" fill="#00FF66"/>
                            <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                        </svg>
                    </div>

                    <div class="floating-chip chip-bottom">
                        <span class="chip-avatar">★</span>
                        <div>
                            <strong>+ Advanced AI &amp; ML Note</strong>
                            <small>Rated 4.9 ★ by 142 students</small>
                        </div>
                        <span class="chip-icon-arrow">↑</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="outpayz-triple-cards">
            <div class="triple-card">
                <span class="triple-card-icon">📂</span>
                <h4>Complete Exam Control</h4>
                <p>Filter by semester, course code, university year, and exam type with zero hassle.</p>
                <a class="triple-link" asp-controller="Account" asp-action="Login">Sign in to Access Exams &rarr;</a>
            </div>

            <div class="triple-card active-green-card">
                <span class="triple-card-icon">🎬</span>
                <h4>Full Playback Lectures</h4>
                <p>Curated playlist of high-yield video lectures covering tricky computer science and math topics.</p>
                <a class="outpayz-btn-primary triple-btn" asp-controller="Account" asp-action="Login">Sign in to Watch Lectures</a>
            </div>

            <div class="triple-card">
                <span class="triple-card-icon">📅</span>
                <h4>Attendance Check-In</h4>
                <p>Mark attendance in real time with unique secure session passcodes issued by instructors.</p>
                <a class="triple-link" asp-controller="Account" asp-action="Login">Sign in to Check Attendance &rarr;</a>
            </div>
        </div>
    </section>
</div>
