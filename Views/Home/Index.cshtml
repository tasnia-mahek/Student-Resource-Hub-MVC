@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="hero-copy">
        <h1>Welcome to StudyHub</h1>
        <p>Your one-stop platform for academic resources</p>
    </div>
</section>

<section class="stats-grid" aria-label="StudyHub statistics">
    <div class="stat-card"><div><span>Total Resources</span><strong>1,234</strong></div><b class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M3.5 5.5A2.5 2.5 0 0 1 6 3h5.5v17H6a2.5 2.5 0 0 0-2.5 2.5v-17Z"/><path d="M20.5 5.5A2.5 2.5 0 0 0 18 3h-6.5v17H18a2.5 2.5 0 0 1 2.5 2.5v-17Z"/></svg></b></div>
    <div class="stat-card"><div><span>Active Users</span><strong>5,678</strong></div><b class="stat-icon stat-icon-green" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m4 16 5-5 4 3 7-7"/><path d="M15 7h5v5"/></svg></b></div>
    <div class="stat-card"><div><span>This Week</span><strong>89</strong></div><b class="stat-icon stat-icon-orange" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/></svg></b></div>
    <div class="stat-card"><div><span>Top Rated</span><strong>156</strong></div><b class="stat-icon stat-icon-gold" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg></b></div>
</section>

<section class="activity-section">
    <div class="section-heading"><h2>Recent Activity</h2><a asp-action="PastPapers">View all</a></div>
    <div class="activity-list">
        <div class="activity-row"><span class="activity-type paper">▤</span><div><strong>Data Structures Final Exam 2024</strong><small>CS-201</small></div><time>2 hours ago</time></div>
        <div class="activity-row"><span class="activity-type lecture">▣</span><div><strong>Advanced Algorithms - Lecture 15</strong><small>CS-401</small></div><time>5 hours ago</time></div>
        <div class="activity-row"><span class="activity-type note">▥</span><div><strong>Calculus III Complete Notes</strong><small>MATH-301</small></div><time>1 day ago</time></div>
        <div class="activity-row"><span class="activity-type paper">▤</span><div><strong>Physics Midterm Spring 2024</strong><small>PHY-102</small></div><time>2 days ago</time></div>
    </div>
</section>

<section class="quick-links">
    <a asp-action="PastPapers"><span>▤</span><div><h2>Browse Past Papers</h2><p>Access thousands of previous year question papers</p></div><b>→</b></a>
    <a asp-action="Lectures"><span>▣</span><div><h2>Watch Lectures</h2><p>Learn from recorded lectures by top professors</p></div><b>→</b></a>
    <a asp-action="Notes"><span>▥</span><div><h2>Study Notes</h2><p>Download comprehensive notes shared by students</p></div><b>→</b></a>
</section>
