@model student_resource_hub.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<section class="auth-page">
    <div class="auth-card auth-card-register">
        <!-- Left Visual Editorial Banner -->
        <div class="auth-visual">
            <div class="auth-visual-top">
                <span class="auth-logo-mark outpayz-logo-mark">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                        <circle cx="12" cy="12" r="3" fill="#00FF66"/>
                        <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>Study<span class="brand-highlight">Hub</span></span>
            </div>

            <div class="auth-visual-copy">
                <span class="auth-kicker">JOIN OUR COMMUNITY</span>
                <h1>Begin your<br /><em>learning chapter</em></h1>
                <p>Collaborate with fellow peers, share lecture notes, and elevate your academic performance.</p>
            </div>

            <div class="auth-visual-orbit orbit-one"></div>
            <div class="auth-visual-orbit orbit-two"></div>
            <span class="auth-visual-star star-one">✦</span>
            <span class="auth-visual-star star-two">✦</span>
            <span class="auth-visual-tag">OPEN SCHOLARSHIP</span>
        </div>

        <!-- Right Register Form -->
        <div class="auth-content">
            <div class="auth-intro">
                <span class="auth-kicker">GET STARTED TODAY</span>
                <h2>Create your account</h2>
                <p>Register as a student and choose your academic placement.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

            <form asp-action="Register" method="post" class="auth-form">
                <div class="auth-field">
                    <label asp-for="FullName">Full Name</label>
                    <input asp-for="FullName" autocomplete="name" placeholder="e.g. Alex Morgan" autofocus />
                    <span asp-validation-for="FullName"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="name@university.edu" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="auth-field-row">
                    <div class="auth-field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" autocomplete="new-password" placeholder="At least 6 characters" />
                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>

                <input type="hidden" asp-for="Role" value="Student" />

                <div id="academic-fields">
                    <div class="auth-field">
                        <label asp-for="UniversityId">University</label>
                        <select asp-for="UniversityId" class="form-control" id="UniversityId">
                            <option value="">Select your university</option>
                            @foreach (var university in Model.Universities)
                            {
                                <option value="@university.Id">@university.Name</option>
                            }
                        </select>
                        @if (Model.Universities.Count == 0)
                        {
                            <small class="auth-inline-hint">No active universities are currently registered.</small>
                        }
                        <span asp-validation-for="UniversityId"></span>
                    </div>
                    <div class="auth-field-row">
                        <div class="auth-field">
                            <label asp-for="AcademicDepartmentId">Department</label>
                            <select asp-for="AcademicDepartmentId" class="form-control" id="AcademicDepartmentId">
                                <option value="">Select your department</option>
                                @foreach (var department in Model.Departments)
                                {
                                    <option value="@department.Id" data-university="@department.UniversityId">@department.Name</option>
                                }
                            </select>
                            <span asp-validation-for="AcademicDepartmentId"></span>
                        </div>
                        <div class="auth-field">
                            <label asp-for="AcademicSemesterId">Semester</label>
                            <select asp-for="AcademicSemesterId" class="form-control" id="AcademicSemesterId">
                                <option value="">Select your semester</option>
                                @foreach (var semester in Model.Semesters)
                                {
                                    <option value="@semester.Id" data-department="@semester.DepartmentId">@semester.Name</option>
                                }
                            </select>
                            <span asp-validation-for="AcademicSemesterId"></span>
                        </div>
                    </div>
                </div>

                <button class="auth-submit" type="submit">
                    <span>Complete Registration</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </form>

            <p class="auth-switch">
                Already have an account? <a asp-action="Login">Sign in here</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const university = document.getElementById('UniversityId');
        const department = document.getElementById('AcademicDepartmentId');
        const semester = document.getElementById('AcademicSemesterId');
        const academicFields = document.getElementById('academic-fields');
        const allDepartments = Array.from(department.options).slice(1).map(option => ({ value: option.value, text: option.text, university: option.dataset.university }));
        const allSemesters = Array.from(semester.options).slice(1).map(option => ({ value: option.value, text: option.text, department: option.dataset.department }));

        function refreshDepartments() {
            const selected = department.value;
            department.innerHTML = '<option value="">Select your department</option>';
            allDepartments.filter(item => !university.value || item.university === university.value).forEach(item => department.add(new Option(item.text, item.value)));
            department.value = Array.from(department.options).some(option => option.value === selected) ? selected : '';
            refreshSemesters();
        }

        function refreshSemesters() {
            const selected = semester.value;
            semester.innerHTML = '<option value="">Select your semester</option>';
            allSemesters.filter(item => !department.value || item.department === department.value).forEach(item => semester.add(new Option(item.text, item.value)));
            semester.value = Array.from(semester.options).some(option => option.value === selected) ? selected : '';
        }

        university.addEventListener('change', refreshDepartments);
        department.addEventListener('change', refreshSemesters);
        academicFields.hidden = false;
        refreshDepartments();
    </script>
}
