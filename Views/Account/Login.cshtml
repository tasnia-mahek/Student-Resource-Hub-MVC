@model student_resource_hub.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<section class="auth-page">
    <div class="auth-card">
        <!-- Left Visual Editorial Banner -->
        <div class="auth-visual">
            <div class="auth-visual-top">
                <span class="auth-logo-mark outpayz-logo-mark">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                        <circle cx="12" cy="12" r="3" fill="#00FF66"/>
                        <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                </span>
                <span>Study<span class="brand-highlight">Hub</span></span>
            </div>

            <div class="auth-visual-copy">
                <span class="auth-kicker">CAMPUS RESOURCE HUB</span>
                <h1>Empowering your<br /><em>academic journey</em></h1>
                <p>Everything you need for revision, past papers, lectures, and semester planning in one unified portal.</p>
            </div>

            <div class="auth-visual-orbit orbit-one"></div>
            <div class="auth-visual-orbit orbit-two"></div>
            <span class="auth-visual-star star-one">✦</span>
            <span class="auth-visual-star star-two">✦</span>
            <span class="auth-visual-tag">ACADEMIC EXCELLENCE</span>
        </div>

        <!-- Right Sign In Form -->
        <div class="auth-content">
            <div class="auth-intro">
                <span class="auth-kicker">WELCOME BACK</span>
                <h2>Sign in to StudyHub</h2>
                <p>Access your personalized learning deck and course materials.</p>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="auth-success" role="status">
                    <span>✓</span>
                    <span>@successMessage</span>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

            <form asp-action="Login" method="post" class="auth-form">
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="auth-field">
                    <label asp-for="Email">Institutional or Personal Email</label>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="name@university.edu" autofocus />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">Account Password</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <button class="auth-submit" type="submit">
                    <span>Sign In to Dashboard</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </form>

            <p class="auth-switch">
                New to StudyHub? <a asp-action="Register">Create an account</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
