@{
    ViewData["Title"] = "AI Study Assistant";
    var userName = User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name) 
        ? User.Identity.Name 
        : "Scholar";
}

<link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />

<div class="ai-assistant-container">
    <!-- Header / Hero Intro with Spark Mascot -->
    <header class="ai-hero-spark">
        <div class="ai-hero-spark-content">
            <span class="ai-spark-badge">
                <span class="spark-badge-glow-dot"></span>
                <span class="spark-badge-text">STUDYHUB AI BUDDY</span>
            </span>
            <h1 class="ai-hero-title">Hey @userName, it’s Spark 💚</h1>
            <p class="ai-hero-desc">Your StudyHub AI buddy — ask me anything about courses, papers, or notes.</p>
            
            <div class="ai-hero-feature-tags">
                <span class="ai-feature-pill">
                    <span class="feature-dot"></span> 24/7 Smart Companion
                </span>
                <span class="ai-feature-pill">
                    <span class="feature-dot"></span> Past Papers &amp; Exams
                </span>
                <span class="ai-feature-pill">
                    <span class="feature-dot"></span> Notes &amp; Course Materials
                </span>
            </div>
        </div>

        <div class="ai-hero-mascot-side">
            <div class="spark-ambient-glow"></div>
            <div class="spark-floating-sparks">
                <span class="sparkle sp-1">✦</span>
                <span class="sparkle sp-2">✦</span>
                <span class="sparkle sp-3">✦</span>
            </div>
            <div class="spark-mascot-card" title="Hi! I'm Spark, your study buddy 💚">
                <img src="~/images/firefly.svg" alt="Spark Firefly Mascot" class="spark-hero-mascot-img" />
                <div class="spark-greeting-bubble">
                    <span>Here to help! ✨</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Chat Interface Card -->
    <div class="ai-chat-card">
        <!-- Chat Header -->
        <div class="ai-chat-header">
            <div class="ai-chat-header-left">
                <div class="ai-avatar-header">
                    <img src="~/images/firefly.svg" alt="Spark" class="ai-header-spark-icon" />
                </div>
                <div>
                    <h3 class="ai-chat-status-title">
                        <span>Spark</span>
                        <span class="spark-status-pill">
                            <span class="ai-status-indicator" title="Spark is Online"></span>
                            <span>Online</span>
                        </span>
                    </h3>
                    <p class="ai-chat-status-sub">Ready to illuminate your study path</p>
                </div>
            </div>
            <div class="ai-chat-header-actions">
                <button type="button" class="ai-header-btn" id="clearChatBtn" title="Clear conversation history">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                    <span>Clear Chat</span>
                </button>
            </div>
        </div>

        <!-- Chat Message Area -->
        <div class="ai-chat-body" id="chatMessageArea">
            <!-- Bot Message: Welcome with Mascot -->
            <div class="ai-message ai-message-bot" id="defaultWelcomeMessage">
                <div class="ai-msg-avatar ai-spark-avatar-wrap">
                    <img src="~/images/firefly.svg" alt="Spark" class="ai-spark-avatar-img" />
                </div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">SPARK 💚</div>
                    <p>Hello <strong>@userName</strong>! 🎓 Welcome to your study haven.</p>
                    <p>I'm Spark, your firefly AI companion. I can help you understand tough concepts, locate approved past papers, find lecture notes, or guide your exam revision:</p>
                    <ul class="spark-welcome-list">
                        <li>📄 <strong>Find past exams:</strong> <em>"give me Industrial Law past papers"</em>, <em>"find the 2025 CSE 110 final"</em></li>
                        <li>📝 <strong>Discover study notes:</strong> <em>"I need CSE 110 notes"</em></li>
                        <li>🎥 <strong>Search video lectures:</strong> <em>"show me Database lectures"</em></li>
                        <li>💡 <strong>Academic explanations:</strong> <em>"do you have anything about recursion?"</em>, <em>"explain binary search trees"</em></li>
                    </ul>
                    <p class="spark-welcome-footer">Tap any suggested prompt below or type your question — let's learn something awesome today! ✨</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            </div>
        </div>

        <!-- Suggested Prompt Chips (Rounded Pills) -->
        <div class="ai-suggestions-container">
            <div class="ai-suggestions-label">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                SUGGESTED PROMPTS
            </div>
            <div class="ai-chips-list">
                <button type="button" class="ai-prompt-chip" data-prompt="give me Industrial Law past papers">
                    <span class="chip-icon">📄</span>
                    <span>Industrial Law past papers</span>
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="I need CSE 110 notes">
                    <span class="chip-icon">📝</span>
                    <span>CSE 110 notes</span>
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="show me Database lectures">
                    <span class="chip-icon">🎥</span>
                    <span>Database lectures</span>
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="do you have anything about recursion?">
                    <span class="chip-icon">💡</span>
                    <span>Anything about recursion?</span>
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="find the 2025 CSE 110 final">
                    <span class="chip-icon">🎓</span>
                    <span>2025 CSE 110 final</span>
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="I need study materials for networking">
                    <span class="chip-icon">🌐</span>
                    <span>Study materials for networking</span>
                </button>
            </div>
        </div>

        <!-- Text Input & Send Action (Rounded Green Border) -->
        <div class="ai-input-area">
            <div class="ai-input-box">
                <div class="ai-input-spark-glyph" title="Ask Spark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                        <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
                    </svg>
                </div>
                <input type="text" id="aiUserInput" class="ai-chat-input" placeholder="Ask Spark about courses, exams, past papers, notes, or topics..." autocomplete="off" />
                <button type="button" id="aiSendBtn" class="ai-send-btn" title="Send message to Spark">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            <div class="ai-disclaimer-row">
                <span class="disclaimer-dot"></span>
                <p class="ai-disclaimer">Spark provides guidance from your academic catalog. Always verify exam specifics with your course syllabus.</p>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("aiUserInput");
        const sendBtn = document.getElementById("aiSendBtn");
        const chatArea = document.getElementById("chatMessageArea");
        const clearBtn = document.getElementById("clearChatBtn");
        const chips = document.querySelectorAll(".ai-prompt-chip");
        const welcomeMessageElement = document.getElementById("defaultWelcomeMessage");

        const currentUsername = "@(User.Identity?.Name ?? "guest")";
        const STORAGE_KEY = "studyhub_ai_chat_history_" + encodeURIComponent(currentUsername);

        let chatHistory = [];

        // Format user-facing timestamp
        function formatCurrentTime() {
            try {
                return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            } catch (e) {
                return "Just now";
            }
        }

        // Save conversation history to localStorage
        function saveChatHistory() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(chatHistory));
            } catch (e) {
                console.warn("Unable to save chat history to localStorage", e);
            }
        }

        // Render user message in DOM
        function renderUserMessage(text, timeText) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-user";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar ai-user-avatar">
                    <span>👤</span>
                </div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">YOU</div>
                    <div class="ai-user-text">${escapeHtml(text)}</div>
                    <span class="ai-msg-time">${escapeHtml(timeText || "Just now")}</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
        }

        // Render bot message in DOM with Spark Mascot Avatar
        function renderBotMessage(contentHtml, timeText) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-bot";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar ai-spark-avatar-wrap">
                    <img src="/images/firefly.svg" alt="Spark" class="ai-spark-avatar-img" />
                </div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">SPARK 💚</div>
                    <div class="ai-bot-content">${contentHtml}</div>
                    <span class="ai-msg-time">${escapeHtml(timeText || "Just now")}</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
        }

        // Load chat history from localStorage on initialization
        function loadChatHistory() {
            try {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        chatHistory = parsed;
                        chatHistory.forEach(item => {
                            if (item.role === 'user') {
                                renderUserMessage(item.content, item.time);
                            } else if (item.role === 'bot') {
                                renderBotMessage(item.content, item.time);
                            }
                        });
                        chatArea.scrollTop = chatArea.scrollHeight;
                    }
                }
            } catch (e) {
                console.warn("Could not load AI Assistant chat history from localStorage", e);
                chatHistory = [];
            }
        }

        // Initialize history
        loadChatHistory();

        // Click on suggested prompt chip immediately triggers search
        chips.forEach(chip => {
            chip.addEventListener("click", function () {
                const promptText = this.getAttribute("data-prompt");
                if (promptText) {
                    input.value = promptText;
                    handleSend();
                }
            });
        });

        // Show Sleepy Mascot + Animated Bouncing Dots While Loading
        function showTypingIndicator() {
            const typingDiv = document.createElement("div");
            typingDiv.className = "ai-message ai-message-bot ai-typing-indicator-row";
            typingDiv.id = "aiTypingIndicator";
            typingDiv.innerHTML = `
                <div class="ai-msg-avatar ai-spark-avatar-wrap ai-sleepy-avatar-wrap">
                    <img src="/images/firefly-sleepy.svg" alt="Spark Thinking" class="spark-sleepy-img" />
                </div>
                <div class="ai-msg-bubble ai-typing-bubble">
                    <div class="ai-msg-sender">SPARK 💚</div>
                    <div class="ai-typing-status">
                        <span class="ai-typing-text">Spark is thinking</span>
                        <div class="ai-dots-bounce" aria-label="Loading">
                            <span class="ai-dot dot-1"></span>
                            <span class="ai-dot dot-2"></span>
                            <span class="ai-dot dot-3"></span>
                        </div>
                    </div>
                </div>
            `;
            chatArea.appendChild(typingDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById("aiTypingIndicator");
            if (indicator) {
                indicator.remove();
            }
        }

        async function handleSend() {
            const text = input.value.trim();
            if (!text) return;

            const userTime = formatCurrentTime();
            renderUserMessage(text, userTime);
            chatHistory.push({ role: 'user', content: text, time: userTime });
            saveChatHistory();

            input.value = "";
            input.disabled = true;
            sendBtn.disabled = true;
            chatArea.scrollTop = chatArea.scrollHeight;

            showTypingIndicator();

            try {
                const response = await fetch('/AiAssistant/Query', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ query: text })
                });

                removeTypingIndicator();

                const botTime = formatCurrentTime();
                if (response.ok) {
                    const data = await response.json();
                    const replyHtml = data.reply || data.Reply || "<p>I could not generate a response. Please try again.</p>";
                    renderBotMessage(replyHtml, botTime);
                    chatHistory.push({ role: 'bot', content: replyHtml, time: botTime });
                    saveChatHistory();
                } else {
                    const errorHtml = "<p style=\"color: #f43f5e;\">Sorry, I encountered an issue processing your request. Please try again.</p>";
                    renderBotMessage(errorHtml, botTime);
                    chatHistory.push({ role: 'bot', content: errorHtml, time: botTime });
                    saveChatHistory();
                }
            } catch (err) {
                removeTypingIndicator();
                console.error("AI assistant search error:", err);
                const networkErrHtml = "<p style=\"color: #f43f5e;\">A network error occurred while processing your request. Please check your connection and try again.</p>";
                const botTime = formatCurrentTime();
                renderBotMessage(networkErrHtml, botTime);
                chatHistory.push({ role: 'bot', content: networkErrHtml, time: botTime });
                saveChatHistory();
            } finally {
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
                chatArea.scrollTop = chatArea.scrollHeight;
            }
        }

        sendBtn.addEventListener("click", handleSend);

        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                handleSend();
            }
        });

        clearBtn.addEventListener("click", function () {
            try {
                localStorage.removeItem(STORAGE_KEY);
            } catch (e) {
                console.warn("Could not clear localStorage", e);
            }
            chatHistory = [];
            chatArea.innerHTML = "";
            if (welcomeMessageElement) {
                chatArea.appendChild(welcomeMessageElement);
            }
        });

        function escapeHtml(string) {
            return String(string).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    });
</script>
