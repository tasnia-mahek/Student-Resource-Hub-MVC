@{
    ViewData["Title"] = "AI Study Assistant";
}

<link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />

<div class="ai-assistant-container">
    <!-- Header / Hero Intro -->
    <header class="ai-hero">
        <span class="ai-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
            </svg>
            AI STUDY ASSISTANT
        </span>
        <h1>StudyHub AI Copilot</h1>
        <p>Your intelligent academic companion. Ask questions about your courses, discover relevant past papers, find study notes, and get personalized exam preparation guidance.</p>
    </header>

    <!-- Chat Interface Card -->
    <div class="ai-chat-card">
        <!-- Chat Header -->
        <div class="ai-chat-header">
            <div class="ai-chat-header-left">
                <div class="ai-avatar-header">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                        <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="ai-chat-status-title">
                        StudyHub Copilot
                        <span class="ai-status-indicator" title="AI Service Online"></span>
                    </h3>
                    <p class="ai-chat-status-sub">Ready to help you excel this semester</p>
                </div>
            </div>
            <div class="ai-chat-header-actions">
                <button type="button" class="ai-header-btn" id="clearChatBtn" title="Clear conversation">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Clear Chat</span>
                </button>
            </div>
        </div>

        <!-- Chat Message Area -->
        <div class="ai-chat-body" id="chatMessageArea">
            <!-- Bot Message: Welcome -->
            <div class="ai-message ai-message-bot">
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <p>Hello, <strong>@(User.Identity?.Name ?? "Scholar")</strong>! 🎓 Welcome to your AI Study Assistant.</p>
                    <p>I can help you navigate your semester with ease. Here are some things you can ask me:</p>
                    <ul>
                        <li>Find past papers and solutions for specific courses (e.g., <em>CSE 110</em>, <em>MAT 101</em>)</li>
                        <li>Recommend top-rated study notes and lecture slides</li>
                        <li>Guide you through your <strong>First-Year Starter Kit</strong> subjects</li>
                        <li>Provide study strategies and exam preparation techniques</li>
                    </ul>
                    <p>Try clicking one of the suggested prompts below or type your own question!</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            </div>

            <!-- Demo User Inquiry -->
            <div class="ai-message ai-message-user">
                <div class="ai-msg-avatar">👤</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">YOU</div>
                    <p>What resources are available for first-year Computer Science students?</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            </div>

            <!-- Demo Bot Reply -->
            <div class="ai-message ai-message-bot">
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <p>For first-year Computer Science students, you have access to verified course materials in the hub:</p>
                    <ul>
                        <li><strong>Structured Programming (CSE 110):</strong> Approved past papers from 2021–2025 and curated lecture slide sets.</li>
                        <li><strong>Calculus &amp; Analytical Geometry (MAT 101):</strong> Comprehensive problem sets and student notes.</li>
                        <li><strong>English &amp; Communication (ENG 101):</strong> Writing guides and presentation templates.</li>
                    </ul>
                    <p>Tip: You can also explore the <strong>First-Year Starter Kit</strong> from the left sidebar to see all subjects organized by your intake semester!</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            </div>
        </div>

        <!-- Suggested Prompt Chips -->
        <div class="ai-suggestions-container">
            <div class="ai-suggestions-label">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                SUGGESTED PROMPTS
            </div>
            <div class="ai-chips-list">
                <button type="button" class="ai-prompt-chip" data-prompt="Find past papers for CSE 110">
                    📄 Find past papers for CSE 110
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="What notes are available for Calculus?">
                    📝 Notes for Calculus
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="How do I use the First-Year Starter Kit?">
                    🎓 First-Year Starter Kit guide
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="Give me 5 study tips for midterm exam preparation">
                    💡 Midterm preparation tips
                </button>
            </div>
        </div>

        <!-- Text Input & Send Action -->
        <div class="ai-input-area">
            <div class="ai-input-box">
                <input type="text" id="aiUserInput" class="ai-chat-input" placeholder="Ask about courses, exams, past papers, or topics..." autocomplete="off" />
                <button type="button" id="aiSendBtn" class="ai-send-btn" title="Send message">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            <p class="ai-disclaimer">StudyHub AI Copilot provides academic guidance based on your institution's catalog. Always verify exam specifics with your course syllabus.</p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("aiUserInput");
        const sendBtn = document.getElementById("aiSendBtn");
        const chatArea = document.getElementById("chatMessageArea");
        const clearBtn = document.getElementById("clearChatBtn");
        const chips = document.querySelectorAll(".ai-prompt-chip");

        const defaultConversation = chatArea.innerHTML;

        chips.forEach(chip => {
            chip.addEventListener("click", function () {
                const promptText = this.getAttribute("data-prompt");
                if (promptText) {
                    input.value = promptText;
                    input.focus();
                }
            });
        });

        function appendUserMessage(text) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-user";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar">👤</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">YOU</div>
                    <p>${escapeHtml(text)}</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function appendBotMessage(text) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-bot";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <p>${escapeHtml(text).replace(/\n/g, '<br>')}</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        async function handleSend() {
            const text = input.value.trim();
            if (!text) return;

            appendUserMessage(text);
            input.value = "";

            try {
                const response = await fetch('/AiAssistant/Ask', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ message: text })
                });

                const payload = await response.json();
                if (!response.ok) {
                    throw new Error(payload?.error || 'Unable to generate a response.');
                }

                appendBotMessage(payload.reply || 'I could not find a relevant answer right now.');
            } catch (error) {
                appendBotMessage('I could not answer that right now. Please try a question about a course, notes, lectures, or past papers.');
            }
        }

        sendBtn.addEventListener("click", handleSend);

        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                handleSend();
            }
        });

        clearBtn.addEventListener("click", function () {
            chatArea.innerHTML = defaultConversation;
        });

        function escapeHtml(string) {
            return String(string).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    });
</script>
