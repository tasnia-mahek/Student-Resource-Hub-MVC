@{
    ViewData["Title"] = "AI Study Assistant";
}

<link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />

<div class="ai-assistant-container">
    <!-- Header / Hero Intro -->
    <header class="ai-hero">
        <span class="ai-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
            </svg>
            AI STUDY ASSISTANT
        </span>
        <h1>StudyHub AI Copilot</h1>
        <p>Your intelligent academic companion. Ask questions about your courses, discover relevant past papers, find study notes, and get personalized exam preparation guidance.</p>
    </header>

    <!-- Chat Interface Card -->
    <div class="ai-chat-card">
        <!-- Chat Header -->
        <div class="ai-chat-header">
            <div class="ai-chat-header-left">
                <div class="ai-avatar-header">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                        <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
                    </svg>
                </div>
                <div>
                    <h3 class="ai-chat-status-title">
                        StudyHub Copilot
                        <span class="ai-status-indicator" title="AI Service Online"></span>
                    </h3>
                    <p class="ai-chat-status-sub">Ready to help you excel this semester</p>
                </div>
            </div>
            <div class="ai-chat-header-actions">
                <button type="button" class="ai-header-btn" id="clearChatBtn" title="Clear conversation">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Clear Chat</span>
                </button>
            </div>
        </div>

        <!-- Chat Message Area -->
        <div class="ai-chat-body" id="chatMessageArea">
            <!-- Bot Message: Welcome -->
            <div class="ai-message ai-message-bot" id="defaultWelcomeMessage">
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <p>Hello, <strong>@(User.Identity?.Name ?? "Scholar")</strong>! 🎓 Welcome to your AI Study Assistant.</p>
                    <p>I can help you navigate your semester with ease across all course materials. Here are some things you can ask me:</p>
                    <ul>
                        <li>Find past papers (e.g., <em>"give me Industrial Law past papers"</em>, <em>"find the 2025 CSE 110 final"</em>)</li>
                        <li>Search notes (e.g., <em>"I need CSE 110 notes"</em>)</li>
                        <li>Look for lectures &amp; slides (e.g., <em>"show me Database lectures"</em>)</li>
                        <li>Ask about any topic (e.g., <em>"do you have anything about recursion?"</em>, <em>"I need study materials for networking"</em>)</li>
                    </ul>
                    <p>Try clicking one of the suggested prompts below or type your own question!</p>
                    <span class="ai-msg-time">Just now</span>
                </div>
            </div>
        </div>

        <!-- Suggested Prompt Chips -->
        <div class="ai-suggestions-container">
            <div class="ai-suggestions-label">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                SUGGESTED PROMPTS
            </div>
            <div class="ai-chips-list">
                <button type="button" class="ai-prompt-chip" data-prompt="give me Industrial Law past papers">
                    📄 Industrial Law past papers
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="I need CSE 110 notes">
                    📝 CSE 110 notes
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="show me Database lectures">
                    🎥 Database lectures
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="do you have anything about recursion?">
                    🔍 Anything about recursion?
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="find the 2025 CSE 110 final">
                    🎓 2025 CSE 110 final
                </button>
                <button type="button" class="ai-prompt-chip" data-prompt="I need study materials for networking">
                    🌐 Study materials for networking
                </button>
            </div>
        </div>

        <!-- Text Input & Send Action -->
        <div class="ai-input-area">
            <div class="ai-input-box">
                <input type="text" id="aiUserInput" class="ai-chat-input" placeholder="Ask about courses, exams, past papers, notes, or topics..." autocomplete="off" />
                <button type="button" id="aiSendBtn" class="ai-send-btn" title="Send message">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                </button>
            </div>
            <p class="ai-disclaimer">StudyHub AI Copilot provides academic guidance based on your institution's catalog. Always verify exam specifics with your course syllabus.</p>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("aiUserInput");
        const sendBtn = document.getElementById("aiSendBtn");
        const chatArea = document.getElementById("chatMessageArea");
        const clearBtn = document.getElementById("clearChatBtn");
        const chips = document.querySelectorAll(".ai-prompt-chip");
        const welcomeMessageElement = document.getElementById("defaultWelcomeMessage");

        const currentUsername = "@(User.Identity?.Name ?? "guest")";
        const STORAGE_KEY = "studyhub_ai_chat_history_" + encodeURIComponent(currentUsername);

        let chatHistory = [];

        // Format user-facing timestamp
        function formatCurrentTime() {
            try {
                return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            } catch (e) {
                return "Just now";
            }
        }

        // Save conversation history to localStorage
        function saveChatHistory() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(chatHistory));
            } catch (e) {
                console.warn("Unable to save chat history to localStorage", e);
            }
        }

        // Render user message in DOM
        function renderUserMessage(text, timeText) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-user";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar">👤</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">YOU</div>
                    <p>${escapeHtml(text)}</p>
                    <span class="ai-msg-time">${escapeHtml(timeText || "Just now")}</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
        }

        // Render bot message in DOM
        function renderBotMessage(contentHtml, timeText) {
            const msgDiv = document.createElement("div");
            msgDiv.className = "ai-message ai-message-bot";
            msgDiv.innerHTML = `
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <div>${contentHtml}</div>
                    <span class="ai-msg-time">${escapeHtml(timeText || "Just now")}</span>
                </div>
            `;
            chatArea.appendChild(msgDiv);
        }

        // Load chat history from localStorage on initialization
        function loadChatHistory() {
            try {
                const stored = localStorage.getItem(STORAGE_KEY);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        chatHistory = parsed;
                        chatHistory.forEach(item => {
                            if (item.role === 'user') {
                                renderUserMessage(item.content, item.time);
                            } else if (item.role === 'bot') {
                                renderBotMessage(item.content, item.time);
                            }
                        });
                        chatArea.scrollTop = chatArea.scrollHeight;
                    }
                }
            } catch (e) {
                console.warn("Could not load AI Assistant chat history from localStorage", e);
                chatHistory = [];
            }
        }

        // Initialize history
        loadChatHistory();

        // Click on suggested prompt chip immediately triggers search
        chips.forEach(chip => {
            chip.addEventListener("click", function () {
                const promptText = this.getAttribute("data-prompt");
                if (promptText) {
                    input.value = promptText;
                    handleSend();
                }
            });
        });

        function showTypingIndicator() {
            const typingDiv = document.createElement("div");
            typingDiv.className = "ai-message ai-message-bot";
            typingDiv.id = "aiTypingIndicator";
            typingDiv.innerHTML = `
                <div class="ai-msg-avatar">✨</div>
                <div class="ai-msg-bubble">
                    <div class="ai-msg-sender">STUDYHUB AI</div>
                    <div style="display: flex; align-items: center; gap: 8px; color: #9ca3af; font-size: 0.88rem; padding: 2px 0;">
                        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #00ff66; box-shadow: 0 0 8px #00ff66;"></span>
                        Thinking...
                    </div>
                </div>
            `;
            chatArea.appendChild(typingDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById("aiTypingIndicator");
            if (indicator) {
                indicator.remove();
            }
        }

        async function handleSend() {
            const text = input.value.trim();
            if (!text) return;

            const userTime = formatCurrentTime();
            renderUserMessage(text, userTime);
            chatHistory.push({ role: 'user', content: text, time: userTime });
            saveChatHistory();

            input.value = "";
            input.disabled = true;
            sendBtn.disabled = true;
            chatArea.scrollTop = chatArea.scrollHeight;

            showTypingIndicator();

            try {
                const response = await fetch('/AiAssistant/Query', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ query: text })
                });

                removeTypingIndicator();

                const botTime = formatCurrentTime();
                if (response.ok) {
                    const data = await response.json();
                    const replyHtml = data.reply || data.Reply || "<p>I could not generate a response. Please try again.</p>";
                    renderBotMessage(replyHtml, botTime);
                    chatHistory.push({ role: 'bot', content: replyHtml, time: botTime });
                    saveChatHistory();
                } else {
                    const errorHtml = "<p style=\"color: #f43f5e;\">Sorry, I encountered an issue processing your request. Please try again.</p>";
                    renderBotMessage(errorHtml, botTime);
                    chatHistory.push({ role: 'bot', content: errorHtml, time: botTime });
                    saveChatHistory();
                }
            } catch (err) {
                removeTypingIndicator();
                console.error("AI assistant search error:", err);
                const networkErrHtml = "<p style=\"color: #f43f5e;\">A network error occurred while processing your request. Please check your connection and try again.</p>";
                const botTime = formatCurrentTime();
                renderBotMessage(networkErrHtml, botTime);
                chatHistory.push({ role: 'bot', content: networkErrHtml, time: botTime });
                saveChatHistory();
            } finally {
                input.disabled = false;
                sendBtn.disabled = false;
                input.focus();
                chatArea.scrollTop = chatArea.scrollHeight;
            }
        }

        sendBtn.addEventListener("click", handleSend);

        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                handleSend();
            }
        });

        clearBtn.addEventListener("click", function () {
            try {
                localStorage.removeItem(STORAGE_KEY);
            } catch (e) {
                console.warn("Could not clear localStorage", e);
            }
            chatHistory = [];
            chatArea.innerHTML = "";
            if (welcomeMessageElement) {
                chatArea.appendChild(welcomeMessageElement);
            }
        });

        function escapeHtml(string) {
            return String(string).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    });
</script>
