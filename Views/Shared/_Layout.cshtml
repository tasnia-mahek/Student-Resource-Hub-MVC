<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyHub</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container-fluid site-header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="StudyHub home">
                <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M3.5 5.5A2.5 2.5 0 0 1 6 3h5.5v17H6a2.5 2.5 0 0 0-2.5 2.5v-17Z"/><path d="M20.5 5.5A2.5 2.5 0 0 0 18 3h-6.5v17H18a2.5 2.5 0 0 1 2.5 2.5v-17Z"/></svg></span><span>StudyHub</span>
            </a>
            <label class="search-box" aria-label="Search resources">
                <span class="search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m16 16 4.3 4.3"/></svg></span>
                <input type="search" placeholder="Search for courses, notes, or past papers..." />
            </label>
            <div class="header-actions">
                <button class="icon-button notification-button" type="button" aria-label="Notifications"><span aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M6 10a6 6 0 0 1 12 0c0 7 2.5 7 2.5 8H3.5c0-1 2.5-1 2.5-8Z"/><path d="M9.5 21h5"/></svg></span><i></i></button>
                <button class="icon-button" type="button" aria-label="Profile"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg></button>
            </div>
        </div>
        <nav class="resource-nav" aria-label="Resource navigation">
            <div class="resource-nav-inner">
                <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index" aria-label="Home"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m4 10 8-6 8 6v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V10Z"/><path d="M9 21v-6h6v6"/></svg></span><span class="nav-label">Home</span></a>
                <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "PastPapers" ? "active" : "")" asp-controller="Home" asp-action="PastPapers" aria-label="Past papers"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M6 3.5h12v17H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></span><span class="nav-label">Past Papers</span></a>
                <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Lectures" ? "active" : "")" asp-controller="Home" asp-action="Lectures" aria-label="Lectures"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><rect x="3.5" y="5" width="17" height="14" rx="1.5"/><path d="m10 9 5 3-5 3V9Z"/></svg></span><span class="nav-label">Lectures</span></a>
                <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Notes" ? "active" : "")" asp-controller="Home" asp-action="Notes" aria-label="Notes"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M5 3.5h14v17H5z"/><path d="M8.5 7h7M8.5 11h7M8.5 15h5"/></svg></span><span class="nav-label">Notes</span></a>
                <a href="#" aria-label="Saved resources"><span class="nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-2.9-5.6 2.9 1.1-6.2L3 9.6l6.2-.9L12 3Z"/></svg></span><span class="nav-label">Favorites</span></a>
            </div>
        </nav>
    </header>
    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">&copy; 2026 StudyHub</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
