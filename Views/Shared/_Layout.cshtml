<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyHub | Modern Academic Resource Hub</title>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
</head>
@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    var isAuthPage = currentController == "Account" && currentAction != "Profile";
    var isLandingPage = currentController == "Home" && (currentAction == "Landing" || (currentAction == "Index" && User.Identity?.IsAuthenticated != true));
}
<body class="@(isAuthPage ? "auth-layout" : "app-body")">
    @if (isAuthPage)
    {
        <!-- Standalone Auth Page Shell -->
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <!-- Unified Application Shell with OutPayz Persistent Navigation -->
        <div class="app-shell @(isLandingPage ? "landing-shell" : "")">
            @if (!isLandingPage)
            {
                <!-- Persistent Left Navigation Sidebar (Only for Logged-In App Workspace) -->
                <aside class="study-sidebar" aria-label="Main sidebar navigation">
                    <a class="study-brand" asp-controller="Home" asp-action="Index" aria-label="StudyHub Home">
                        <span class="study-brand-mark outpayz-logo-mark">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="12" r="3" fill="#00FF66"/>
                                <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                            </svg>
                        </span>
                        <span class="study-brand-name">Study<span class="brand-highlight">Hub</span></span>
                    </a>

                    <nav class="study-sidebar-nav" aria-label="Dashboard navigation">
                        <span class="study-nav-label">MAIN MENU</span>
                        <a class="@(currentController == "Home" && currentAction == "Index" ? "study-nav-active" : "")" asp-controller="Home" asp-action="Index">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            </span>
                            <span>Dashboard</span>
                        </a>
                        <a class="@(currentController == "StarterKit" ? "study-nav-active" : "")" asp-controller="StarterKit" asp-action="Index">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                                </svg>
                            </span>
                            <span>First-Year Starter Kit</span>
                        </a>
                        <a class="@(currentController == "Attendance" ? "study-nav-active" : "")" asp-controller="Attendance" asp-action="Index">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            </span>
                            <span>Attendance</span>
                        </a>
                        <a class="@(currentAction == "PastPapers" || currentAction == "PastPaperDetails" || currentAction == "UploadPastPaper" || currentAction == "ViewPastPaper" ? "study-nav-active" : "")" asp-controller="Resource" asp-action="PastPapers">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            </span>
                            <span>Past Papers</span>
                        </a>
                        <a class="@(currentAction == "Lectures" || currentAction == "LectureDetails" || currentAction == "UploadLecture" ? "study-nav-active" : "")" asp-controller="Resource" asp-action="Lectures">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                            </span>
                            <span>Video Lectures</span>
                        </a>
                        <a class="@(currentAction == "Notes" || currentAction == "NoteDetails" || currentAction == "UploadNote" ? "study-nav-active" : "")" asp-controller="Resource" asp-action="Notes">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                            </span>
                            <span>Study Notes</span>
                        </a>
                        <a class="@(currentAction == "Favorites" ? "study-nav-active" : "")" asp-controller="Home" asp-action="Favorites">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            </span>
                            <span>Favorites</span>
                        </a>
                        @if (User.IsInRole("Student") || User.IsInRole("CR"))
                        {
                            <a class="@(currentController == "Study" ? "study-nav-active" : "")" asp-controller="Study" asp-action="Sessions">
                                <span class="nav-glyph">📁</span>
                                <span>Study Sessions</span>
                            </a>
                        }
                        <a class="@(currentController == "AiAssistant" ? "study-nav-active" : "")" asp-controller="AiAssistant" asp-action="Index">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2l2.4 5 5 2.4-5 2.4-2.4 5-2.4-5-5-2.4 5-2.4z"/>
                                    <path d="M19 15l1.2 2.5 2.5 1.2-2.5 1.2-1.2 2.5-1.2-2.5-2.5-1.2 2.5-1.2z"/>
                                </svg>
                            </span>
                            <span>AI Study Assistant</span>
                        </a>

                        <span class="study-nav-label study-nav-space">RESOURCES &amp; TOOLS</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="@(currentController == "Admin" ? "study-nav-active" : "")" asp-controller="Admin" asp-action="AcademicCatalog">
                                <span class="nav-glyph">⚙</span>
                                <span>Academic Catalog</span>
                            </a>
                        }
                        <a class="@(currentAction == "Privacy" ? "study-nav-active" : "")" asp-controller="Home" asp-action="Privacy">
                            <span class="nav-glyph">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            </span>
                            <span>Policy &amp; Rules</span>
                        </a>
                    </nav>

                    <div class="study-sidebar-footer">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="study-sidebar-profile-link" asp-controller="Account" asp-action="Profile" title="Open your profile">
                                <span class="study-avatar">@string.Concat((User.Identity?.Name ?? "Student").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(name => name[0]))</span>
                                <div class="study-sidebar-user-info">
                                    <strong>@(User.Identity?.Name ?? "Student Account")</strong>
                                    <small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Active Scholar")</small>
                                </div>
                            </a>
                        }
                    </div>
                </aside>
            }

            <!-- Main Workspace Area -->
            <div class="app-main-wrapper">
                <!-- Global OutPayz-Style Topbar Header -->
                <header class="site-header">
                    <div class="site-header-inner">
                        <!-- Left: Brand (on landing page) & Main Links -->
                        <div class="site-header-left">
                            @if (isLandingPage)
                            {
                                <a class="study-brand landing-brand" asp-controller="Home" asp-action="Index" aria-label="StudyHub Home">
                                    <span class="study-brand-mark outpayz-logo-mark">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <circle cx="12" cy="12" r="3" fill="#00FF66"/>
                                            <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    <span class="study-brand-name">Study<span class="brand-highlight">Hub</span></span>
                                </a>
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="header-nav-links d-none d-lg-flex">
                                    <a class="header-nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a>
                                    <a class="header-nav-item @(currentAction == "PastPapers" || currentController == "Resource" && currentAction.Contains("PastPaper") ? "active" : "")" asp-controller="Resource" asp-action="PastPapers">Past Papers</a>
                                    <a class="header-nav-item @(currentAction == "Lectures" || currentController == "Resource" && currentAction.Contains("Lecture") ? "active" : "")" asp-controller="Resource" asp-action="Lectures">Lectures</a>
                                    <a class="header-nav-item @(currentAction == "Notes" || currentController == "Resource" && currentAction.Contains("Note") ? "active" : "")" asp-controller="Resource" asp-action="Notes">Notes</a>
                                    <a class="header-nav-item @(currentController == "Attendance" ? "active" : "")" asp-controller="Attendance" asp-action="Index">Attendance</a>
                                    <a class="header-nav-item @(currentAction == "Favorites" ? "active" : "")" asp-controller="Home" asp-action="Favorites">Saved</a>
                                </div>
                            }
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Search Bar with Shortcut -->
                            <label class="search-box" aria-label="Search resources">
                                <span class="search-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="11" cy="11" r="8"/>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                    </svg>
                                </span>
                                <input type="search" placeholder="Search papers, lectures, notes, course codes..." />
                                <span class="search-shortcut">⌘K</span>
                            </label>
                        }

                        <!-- Header Right Actions -->
                        <div class="header-actions">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- Notification Center Bell Trigger & Dropdown -->
                                <div class="notification-wrapper">
                                    <button class="notification-bell-btn" type="button" aria-label="Open notifications" aria-haspopup="true" aria-expanded="false" title="Notifications">
                                        <svg class="bell-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                        </svg>
                                        <span class="notification-badge-count" aria-live="polite">0</span>
                                    </button>

                                    <!-- Dropdown Panel -->
                                    <div class="notification-dropdown" role="region" aria-label="Notifications panel">
                                        <div class="notification-dropdown-header">
                                            <div class="notif-header-title-wrap">
                                                <h3 class="notif-header-title">Notifications</h3>
                                                <span class="notif-unread-pill">0 new</span>
                                            </div>
                                            <button class="notif-mark-all-btn" type="button">
                                                <span>✓</span>
                                                <span>Mark all as read</span>
                                            </button>
                                        </div>

                                        <div class="notification-dropdown-tabs">
                                            <button class="notif-tab-btn is-active" type="button" data-filter="all">All</button>
                                            <button class="notif-tab-btn" type="button" data-filter="unread">Unread</button>
                                            <button class="notif-tab-btn" type="button" data-filter="academic">Academic</button>
                                            <button class="notif-tab-btn" type="button" data-filter="system">System</button>
                                        </div>

                                        <div class="notification-dropdown-body">
                                            <!-- Populated dynamically by notifications.js -->
                                        </div>

                                        <div class="notification-dropdown-footer">
                                            <a class="notif-view-all-link" asp-controller="Home" asp-action="Notifications">
                                                <span>View all notifications</span>
                                                <span aria-hidden="true">&rarr;</span>
                                            </a>
                                            <button class="notif-clear-read-btn" type="button">Clear read</button>
                                        </div>
                                    </div>
                                </div>

                                <a class="auth-user-pill profile-nav-link" asp-controller="Account" asp-action="Profile" title="Open your profile">
                                    <span class="profile-avatar profile-avatar-small" aria-hidden="true">@string.Concat((User.Identity?.Name ?? "Student").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(name => name[0]))</span>
                                    <span class="auth-user-name">@(User.Identity?.Name ?? "Student")</span>
                                </a>
                                <div class="auth-user-pill auth-user-actions">
                                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;margin:0;">
                                        <button class="auth-logout-btn" type="submit" title="Sign out">Logout</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="auth-group">
                                    <a class="outpayz-btn-ghost" asp-controller="Account" asp-action="Login">Sign In</a>
                                    <a class="outpayz-btn-primary" asp-controller="Account" asp-action="Register">Get Started</a>
                                </div>
                            }
                        </div>
                    </div>
                </header>

                <!-- Page Body Content -->
                <main class="app-main-content" role="main">
                    @RenderBody()
                </main>

                <!-- Modern Multi-Column Footer -->
                <footer class="site-footer">
                    <div class="footer-inner">
                        <div class="footer-grid">
                            <div class="footer-brand">
                                <h4>
                                    <span class="outpayz-logo-mark" style="width:28px; height:28px; display:inline-flex;">
                                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
                                            <circle cx="12" cy="12" r="3" fill="#00FF66"/>
                                            <path d="M12 2V6M12 18V22M2 12H6M18 12H22M4.93 4.93L7.76 7.76M16.24 16.24L19.07 19.07M4.93 19.07L7.76 16.24M16.24 7.76L19.07 4.93" stroke="#00FF66" stroke-width="2.2" stroke-linecap="round"/>
                                        </svg>
                                    </span>
                                    StudyHub
                                </h4>
                                <p>Modern high-performance academic resource hub. Designed for students, researchers, and faculties.</p>
                                <div class="footer-badges">
                                    <span class="outpayz-status-pill">● System Operational</span>
                                    <span class="badge badge-outline">v2.4 LTS</span>
                                </div>
                            </div>
                            <div class="footer-col">
                                <h5>Resource Library</h5>
                                <ul>
                                    <li><a asp-controller="Resource" asp-action="PastPapers">Past Examinations</a></li>
                                    <li><a asp-controller="Resource" asp-action="Lectures">Video Lectures</a></li>
                                    <li><a asp-controller="Resource" asp-action="Notes">Student Notes</a></li>
                                    <li><a asp-controller="Home" asp-action="Favorites">Saved Collection</a></li>
                                </ul>
                            </div>
                            <div class="footer-col">
                                <h5>Campus Portal</h5>
                                <ul>
                                    <li><a asp-controller="Attendance" asp-action="Index">Attendance Hub</a></li>
                                    <li><a asp-controller="Account" asp-action="Login">Student Login</a></li>
                                    <li><a asp-controller="Account" asp-action="Register">Create Account</a></li>
                                    <li><a asp-controller="Home" asp-action="Index">Dashboard Workspace</a></li>
                                </ul>
                            </div>
                            <div class="footer-col">
                                <h5>Guidelines &amp; Help</h5>
                                <ul>
                                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                                    <li><a asp-controller="Home" asp-action="Privacy">Submission Rules</a></li>
                                    <li><a asp-controller="Home" asp-action="Privacy">Terms of Service</a></li>
                                    <li><a href="mailto:support@studyhub.edu">Contact Support</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="footer-bottom">
                            <div>&copy; 2026 StudyHub. Built for academic excellence and collaborative learning.</div>
                            <div style="display:flex; gap:18px;">
                                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                                <a asp-controller="Home" asp-action="Privacy">Terms</a>
                                <a asp-controller="Home" asp-action="Privacy">Security</a>
                            </div>
                        </div>
                    </div>
                </footer>
            </div>
        </div>
    }

    <!-- Global Resource Preview Modal -->
    <div class="modal-overlay" id="resourcePreviewModal" aria-hidden="true" role="dialog" aria-labelledby="modalResourceTitle">
        <div class="modal-dialog">
            <div class="modal-header">
                <div>
                    <span class="badge badge-primary" id="modalResourceBadge">Academic Resource</span>
                    <h3 id="modalResourceTitle" style="margin-top:6px;">Resource Title</h3>
                </div>
                <button class="modal-close-btn" type="button" data-modal-close aria-label="Close modal">&times;</button>
            </div>
            <div class="modal-body">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
                    <span class="badge badge-outline" id="modalResourceCode">CS-201</span>
                    <span id="modalResourceMeta" style="color:var(--text-secondary); font-size:13px;">Verified Course Material</span>
                </div>
                <div style="padding:18px; border-radius:var(--radius-md); background:var(--bg-surface-alt); border:1px solid var(--border-default); margin-bottom:20px;">
                    <h4 style="font-size:14px; margin-bottom:8px; color:var(--text-primary);">Document Preview &amp; Outline</h4>
                    <p style="color:var(--text-secondary); font-size:13px; line-height:1.6; margin:0;">
                        This resource is verified by campus moderators and fellow students. Contains comprehensive study guides, practice questions, syllabus review points, and instructor-approved answers.
                    </p>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                    <div style="padding:12px; border-radius:var(--radius-sm); border:1px solid var(--border-default); text-align:center;">
                        <small style="color:var(--text-muted); display:block;">File Format</small>
                        <strong style="color:var(--text-primary); font-size:14px;">PDF / High Quality</strong>
                    </div>
                    <div style="padding:12px; border-radius:var(--radius-sm); border:1px solid var(--border-default); text-align:center;">
                        <small style="color:var(--text-muted); display:block;">License</small>
                        <strong style="color:var(--accent-emerald); font-size:14px;">Academic Open Access</strong>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary btn-sm" type="button" data-modal-close>Close</button>
                <button class="btn btn-primary btn-sm" type="button" onclick="StudyHub.showToast('Starting file download...');">Download Resource</button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
